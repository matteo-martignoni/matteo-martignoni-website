---
import OdeV2Layout from '../../../layouts/OdeV2Layout.astro';
import { odeMeta, odeRoutes } from '../../../i18n/ode-v2';

const lang = 'en' as const;
const m = odeMeta[lang].glossario;
const r = odeRoutes[lang];

// Grouped glossary. `id` is the anchor used by inline links from other pages,
// and is kept identical to the Italian page so both versions stay in step.
// Definitions are short, and they state the limit whenever there is one.
const groups = [
  {
    group: 'The parameter that decides',
    terms: [
      { id: 'acidita', t: 'Acid value', d: 'Milligrams of potassium hydroxide needed to neutralise the free fatty acids in one gram of fat. Determined by titration under EN ISO 660. According to established chemistry it is the parameter on which the barrier safety of a topical lipid depends, and it costs a few tens of euros. No acid value threshold, however, has ever been validated against a cutaneous outcome: the existing limits are commercial grade thresholds.' },
      { id: 'ffa', t: 'Free fatty acids', d: 'Fatty acids no longer bound to glycerol. They are generated by hydrolysis, that is by cleavage of the ester bond through enzymes, moisture, heat or light. They are the chemical form that disturbs the lamellar order of the skin barrier, unlike the bound form.' },
      { id: 'trigliceride', t: 'Triglyceride', d: 'Three fatty acids bound to one glycerol molecule. It is the form in which fatty acids occur in tallow. The distinction between bound and free form is the technical foundation of OdE.' },
      { id: 'lipasi', t: 'Lipase', d: 'An enzyme that hydrolyses the ester bond of lipids. Skin bacteria produce lipases, and can therefore release fatty acids from a triglyceride applied to the skin. It is the main complication of the OdE thesis, described in full on the Thesis page.' },
      { id: 'idrolisi', t: 'In situ hydrolysis', d: 'The cleavage of the triglyceride that occurs on the skin, after application, through microbial lipases. Neither its kinetics nor its composition has ever been measured on the OdE material: it is the most serious gap in the evidence library.' },
      { id: 'composizione-rilascio', t: 'Composition of the release', d: 'Which fatty acids hydrolysis releases, and in what proportion, as distinct from the mere speed at which the material hydrolyses. It is the distinction that decides the sign of the effect, because the expected mixture contains both fatty acids with unfavourable evidence and fatty acids with favourable evidence. It is the proprietary datum OdE has to generate.' },
      { id: 'oleico', t: 'Oleic acid', d: 'An eighteen-carbon monounsaturate, roughly 38 to 45% of the tallow profile. In free form it is the molecule on which the barrier disruption principle is established. The result concerns oleic acid and is not extensible to the class of free fatty acids.' },
      { id: 'saturi-dominanti', t: 'Palmitic and stearic acid', d: 'The two dominant saturated fatty acids of tallow, together roughly 46% of the profile. Applied topically to damaged human skin ex vivo they increase lipid production and transport in the stratum corneum. This is grade B1 evidence, translated from damaged to healthy skin, with authors of industrial provenance: it qualifies the hydrolysis risk, it does not authorise any claim about tallow.' },
    ],
  },
  {
    group: 'Raw material and process',
    terms: [
      { id: 'sego', t: 'Tallow', d: 'Rendered and refined bovine or ovine fat. International cosmetic ingredient nomenclature: Tallow. It is the primary matrix of OdE. There is no clinical study measuring its effect on human skin.' },
      { id: 'lardo', t: 'Lard and porcine fat', d: 'Rendered porcine fat. The reference acid value limit for pure rendered lard is stricter than the one for tallow, and it reflects raw material selection rather than a property of the species.' },
      { id: 'rendering', t: 'Rendering', d: 'The thermal process that extracts fat from animal by-products. Its conditions determine the acid value, peroxides and oxysterols of the final product. Low temperature rendering is a documented and measurable process lever.' },
      { id: 'soa', t: 'Animal by-products', d: 'Animal materials not intended for human consumption. Fat for cosmetic use must be Category 3, that is low risk, from animals subjected to ante and post mortem inspection.' },
      { id: 'cat3', t: 'Category 3', d: 'The only by-product category eligible for feed and cosmetics. It requires no chemical marker for rendered fats, which makes documentary separation from the other categories particularly critical.' },
      { id: 'custodia', t: 'Chain of custody', d: 'A system of agreements and records that segregates batches by origin across slaughterhouse, rendering and transport. It exists to document the provenance of the fat at the point where the individual identity of the animal dissolves into the lot.' },
    ],
  },
  {
    group: 'Measurement and oxidative state',
    terms: [
      { id: 'perossidi', t: 'Peroxide value', d: 'A measure of primary oxidation, in milliequivalents of oxygen per kilogram. The Codex reference threshold for named animal fats is 10 meq O₂/kg. It is a transient indicator: peroxides form and then decompose.' },
      { id: 'anisidina', t: 'p-Anisidine value', d: 'A measure of secondary oxidation, that is of the products accumulating after peroxides decompose. Complementary to the peroxide value precisely because it is not transient.' },
      { id: 'totox', t: 'TOTOX', d: 'A composite index: twice the peroxide value plus the p-anisidine value. It combines primary and secondary oxidation in a single number.' },
      { id: 'ors', t: 'Oxidative Risk Score', d: 'The AMSA summary score that condenses the oxidative state of a batch from standardised parameters. It is a metric of material quality and stability, not a predictor of cutaneous outcome: the bridge between measured oxidative state and skin outcome does not exist in the literature for triglycerides.' },
      { id: 'cops', t: 'Cholesterol oxidation products', d: 'Oxidation products of cholesterol. Cholesterol is the only oxidation substrate present in tallow and absent by construction from vegetable oils. The ones formed thermally belong to the class with an unfavourable biological profile, while other oxysterols have opposite effects: this is why the Passport reports speciation and not a total.' },
      { id: 'sfc', t: 'Solid fat content', d: 'The fraction of a fat that is in the solid phase at a given temperature, measured by low resolution magnetic resonance. At skin temperature tallow is semi-solid, that is in the physical class of petrolatum and not of liquid oils. The value for tallow at 32 °C is a derived calculation by interpolation, not a direct measurement.' },
      { id: 'pufa', t: 'Polyunsaturates', d: 'Fatty acids with more than one double bond. Fewer polyunsaturates means greater oxidative stability. Their share in tallow should depend on the animal diet, and it is the first point at which provenance would produce a measurable property of the material instead of a story. The reference figure, however, comes from a popular source and must be re-verified on our own sample before any use.' },
      { id: 'gc', t: 'Gas chromatography', d: 'With flame ionisation detection it quantifies the fatty acid profile; with mass spectrometry it confirms structure, and it is the method used for oxysterol speciation.' },
    ],
  },
  {
    group: 'Cutaneous effects and categories',
    terms: [
      { id: 'tewl', t: 'Transepidermal water loss', d: 'The flux of water crossing the skin barrier, measured by evaporimetry. It is the most validated endpoint for assessing barrier integrity. No measurement on pure tallow applied as such was found in the literature.' },
      { id: 'emolliente', t: 'Emollient', d: 'An ingredient that fills the spaces between desquamating corneocytes and returns softness, flexibility and lubricity to the surface. It is the category tallow belongs to by mechanism. Its endpoints are instrumental: desquamation index, microtopography, elasticity, friction coefficient.' },
      { id: 'occlusivo', t: 'Occlusive', d: 'An ingredient that slows water loss by forming a film on the surface. The benchmark of the category is petrolatum. No triglyceride comes close, and OdE claims no occlusive superiority.' },
      { id: 'appiccicosita', t: 'Tackiness', d: 'Measured as adhesion force with a texture analyser. For an emollient it is a defect on the primary endpoint of the category, because it produces the opposite friction profile to the desired one. It is instrumentally documented on bovine tallow.' },
      { id: 'comedogenicita', t: 'Comedogenicity', d: 'The tendency to favour comedone formation. The value circulating for tallow is extrapolated from data on fatty acids in free form and on their monohydric alcohol esters, that is from molecules in a different chemical form. On tallow it has never been measured: it is neither proven comedogenic nor proven non-comedogenic, it is untested.' },
      { id: 'sebo', t: 'Human sebum', d: 'The secretion of the sebaceous glands. It contains roughly 25% wax esters and 12 to 15% squalene, both absent from tallow, and a characteristic fatty acid exclusive to the human species. The similarity between tallow and sebum is therefore true for the triglyceride fraction alone.' },
      { id: 'alphagal', t: 'Alpha-gal', d: 'A sugar epitope present in non-primate mammals, subject of an allergic syndrome whose primary sensitisation occurs through tick bite. Its content in an ultrapurified tallow has never been quantified. Seropositivity is not the same as the syndrome, and prevalence is strongly regional.' },
    ],
  },
  {
    group: 'Technology',
    terms: [
      { id: 'amsa', t: 'AMSA', d: 'An artificial intelligence guided multimodal spectroscopic agent. It does not predict what tallow does to skin, because nobody knows: it measures and states what is in a batch.' },
      { id: 'passaporto', t: 'Digital Lipid Passport', d: 'The nine-section document that travels with the batch. The ninth section lists what has NOT been tested.' },
      { id: 'spettroscopia', t: 'NIR and Raman spectroscopy', d: 'Techniques that read the molecular vibrational fingerprint. On animal fats they are disturbed by weak unsaturation signals and by fluorescence, hence the need to control acquisition actively.' },
      { id: 'chemiometria', t: 'Chemometrics', d: 'Statistical methods for extracting chemical information from spectra. It is the mature, validated base, and it is the baseline an advanced model must beat to go into production.' },
      { id: 'fewshot', t: 'Few-shot learning', d: 'Strategies that hold up when available labels number in the tens rather than the thousands, the typical condition of a supply chain dataset that is expensive to characterise.' },
      { id: 'ood', t: 'Out-of-distribution distance', d: 'A score that flags when a sample is far from what the model knows. It triggers caution, replicates or referral to an external test, not a self-confident prediction.' },
    ],
  },
  {
    group: 'Regulation and claims',
    terms: [
      { id: 'cpsr', t: 'Cosmetic product safety report', d: 'The document assessing the safety of a cosmetic, signed by a qualified assessor. For tallow the existing safety evidence is derived from constituents and not from primary data on the material.' },
      { id: 'criteri', t: 'Common criteria for claims', d: 'Six European criteria every cosmetic claim must satisfy: legal compliance, truthfulness, evidential support, honesty, fairness and informed decision making. They are the yardstick used to build the claim taxonomy published in the Audit.' },
      { id: 'eudr', t: 'Deforestation regulation', d: 'A European rule imposing due diligence and geolocation for a closed list of relevant products. The customs code for fats of bovine, ovine and caprine animals is not on it: tallow is out of scope. The exemption is not exclusive to tallow, and it is a documentary compliance argument, never one of environmental superiority.' },
      { id: 'dpp', t: 'Digital Product Passport', d: 'An instrument provided for by the European ecodesign regulation, rolled out product group by product group through delegated acts. No delegated act found covers cosmetic lipid ingredients: the Lipid Passport is today a voluntary differentiator and only potentially a future obligation.' },
      { id: 'codex', t: 'Codex CXS 211-1999', d: 'The international standard on named animal fats. It sets acid value and peroxide limits and comparative physical parameters. These are food grade commercial thresholds, not cutaneous safety thresholds.' },
      { id: 'gmp', t: 'Good manufacturing practice', d: 'Cosmetic manufacturing rules requiring batch traceability. They are access keys to the professional customer, and a requirement, not a differentiator.' },
    ],
  },
  {
    group: 'Method and epistemology',
    terms: [
      { id: 'gradi', t: 'Evidence grades', d: 'The scale used throughout the library: A1 is a controlled study on human skin in vivo with instrumental measurement and an active comparator; A2 is weaker by design or sample; B1 is ex vivo; B2 is an animal or in vitro model; C is a review, guideline or subjective outcome; D is a commercial source, with no evidential value. On topical tallow, grades A1 and A2 stand at zero.' },
      { id: 'lacuna', t: 'Verified gap', d: 'A documented negative result: the relevant basin was searched exhaustively and nothing was found. It must be distinguished from demonstrated absence of data and from an untested hypothesis, that is from the case where the basin was not searched at all. An unexplored basin is not a verified negative result.' },
      { id: 'errore-matrice', t: 'Matrix error', d: 'Attributing to one material data measured on a chemically different material. It is recurrent in this category: tallow amine derivatives read as triglyceride tallow, vegetable fats read as animal, systemic routes read as cutaneous application. The detail is in the Audit.' },
      { id: 'requisito', t: 'Requirement versus differentiator', d: 'A requirement must be satisfied anyway and produces no competitive advantage. A differentiator is discretionary and produces advantage only if communicated. Confusing the two leads to spending on compliance while believing you are building positioning.' },
      { id: 'arte-nota', t: 'Prior art and freedom to operate', d: 'The body of technical solutions already published, typically in patents. A process covered by expired prior art can be used freely and without licences, but for the same reason it cannot be a competitive advantage. For the fractionation and refining of tallow the prior art is public and largely expired: the OdE moat cannot be the process.' },
      { id: 'evidenza-traslata', t: 'Translated evidence', d: 'A result obtained in one context and applied by analogy to a different one, for example from damaged to healthy skin, or from isolated fatty acids to a matrix containing them. It must be declared as such: it is more than nothing and much less than a demonstration.' },
      { id: 'gate', t: 'Decision gate', d: 'A numerical threshold or an observable event, written before the data exist, that establishes whether to continue, stop or change direction. No gate can be passed by a signal that costs the other party nothing.' },
    ],
  },
];
---
<OdeV2Layout title={m.title} description={m.description} lang={lang} pageKey="glossario">
  <header class="pg">
    <p class="ode-eyebrow">Glossary</p>
    <h1>The terms, explained</h1>
    <p class="lede">
      The vocabulary used across the site, from fat chemistry to regulation to method.
      Where a definition has a limit, the limit is part of the definition.
    </p>
  </header>

  <nav class="toc" aria-label="Glossary index">
    {groups.map((grp) => <a href={`#${grp.terms[0].id}`}>{grp.group}</a>)}
  </nav>

  {groups.map((grp) => (
    <section class="grp">
      <h2 class="grp-title">{grp.group}</h2>
      <dl class="terms">
        {grp.terms.map((term) => (
          <div class="term" id={term.id}>
            <dt>{term.t}</dt>
            <dd>{term.d}</dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <p class="note back">
    Back to <a href={r.home}>the home page</a>, the <a href={r.audit}>Audit</a> or the
    <a href={r.tesi}>Thesis</a>.
  </p>
</OdeV2Layout>

<style>
  .toc { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin: 1.5rem 0 2.5rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--rule); }
  .toc a { font-size: 0.85rem; color: var(--accent); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }

  .grp { margin: 2.5rem 0; }
  .grp-title { font-size: 1.15rem; font-weight: 500; color: var(--ink); margin: 0 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); }
  .terms { margin: 0; display: grid; gap: 1.1rem; }
  .term { scroll-margin-top: 1.5rem; }
  .term dt { font-weight: 500; color: var(--ink); margin-bottom: 0.2rem; }
  .term dd { margin: 0; font-size: 0.93rem; line-height: 1.55; color: var(--body); max-width: 46rem; }
  .term:target dt { color: var(--accent); }
  .term:target { border-left: 3px solid var(--green-border); padding-left: 0.9rem; margin-left: -1.2rem; }
  .back { margin-top: 2.5rem; }
</style>
