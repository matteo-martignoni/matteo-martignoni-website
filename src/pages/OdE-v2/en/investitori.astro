---
import OdeV2Layout from '../../../layouts/OdeV2Layout.astro';
import Section from '../../../components/ode/Section.astro';
import DataTag from '../../../components/ode-v2/DataTag.astro';
import Status from '../../../components/ode-v2/Status.astro';
import Finding from '../../../components/ode-v2/Finding.astro';
import Callout from '../../../components/ode-v2/Callout.astro';
import StatCard from '../../../components/ode-v2/StatCard.astro';
import ReadNext from '../../../components/ode-v2/ReadNext.astro';
import { odeMeta, odeRoutes } from '../../../i18n/ode-v2';

const lang = 'en' as const;
const m = odeMeta[lang].investitori;
const r = odeRoutes[lang];

const scenarios = [
  {
    k: 'Minimum',
    cost: '18,000-41,000 €',
    pct: '5-12%',
    dur: '4-6 months',
    what: 'Zero-cost checks, the full analytical panel, per-batch analytics, documentary package, safety dossier, alpha-gal quantification.',
    say: 'Traced ingredient, qualified batch by batch, safe per dossier, not derived from palm oil, with fatty acid profile, solid fat content at skin temperature and oxidative state measured and certified. No efficacy claim.',
    v: 'Mandatory starting point',
  },
  {
    k: 'Intermediate',
    cost: '55,000-90,000 €',
    pct: '16-26%',
    dur: '8-12 months',
    what: 'The minimum, plus the in vitro hydrolysis study, the barrier safety arm and the sensory module.',
    say: 'Adds characterised kinetics AND composition of the release, documented barrier behaviour under single application, measured sensory profile. This is the first proprietary datum.',
    v: 'Reasonable ceiling',
  },
  {
    k: 'Complete',
    cost: '115,000-240,000 €',
    pct: '33-69%',
    dur: '18-24 months',
    what: 'The full programme, including the comparative arm, the clinical comedogenicity study and the fractionation mapping.',
    say: 'Adds emollient performance on validated endpoints and competitive claims, conditional on outcomes.',
    v: 'To be excluded absent additional capital',
  },
];

const swot = {
  f: [
    'The principle of the esterified form and low acid value is the most defensible scientific claim available, and it rests on a study in human skin.',
    'The two dominant saturated fatty acids of the material, together roughly 46% of the profile, have ex vivo evidence of barrier reconstruction. Grade B1, on damaged skin and with isolated fatty acids: it qualifies the risk, it does not license a claim.',
    'At skin temperature the material is semisolid and fully melted only at 46 °C: the physical class of petrolatum, with a thermal ranking now documented from a primary source.',
    'Cholesterol oxidation products are a marker no plant matrix possesses, with a documented process lever and a definable numerical target.',
    'Traceability and circularity are verifiable rather than narrative, which is more than the market average offers.',
    'A declaration of non-derivation from palm oil is a near-zero-cost field, verifiable and uncontestable.',
    'The audit of two documented attribution errors in the sector literature, traced back to source, is a credibility asset at zero cost.',
  ],
  d: [
    'Total absence of high-grade evidence on topical tallow: it does not reach the minimum bar a formulator expects.',
    'Stickiness documented instrumentally, on the bovine matrix, on the primary endpoint of the category the material belongs to.',
    'Exposure to in situ lipase hydrolysis, asymmetric with respect to hydrocarbon and silicone comparators. Qualified: the direction of the net effect is unknown, not negative.',
    'Inability to compete on occlusion and on barrier repair.',
    'No defensible intellectual property on fractionation or refining: the prior art is public and largely expired.',
    'Very small structure, limited reporting capacity, no in-house laboratory.',
    'Two of the three public-finance instruments and all the tax incentives depend on a status not yet secured, which in turn depends on an open question: whether the artificial intelligence in AMSA is substantial or marginal.',
  ],
  o: [
    'No operator today offers traceability, an oxidative risk index and per-batch characterisation combined in a single document.',
    'On the emollient axis the outcome of a study is genuinely unknown and the literature is poorly indexed: the marginal value of a new datum is high.',
    'The window for being first with clinical data is still open as of the latest bibliographic check.',
    'The documentary asymmetry on deforestation opens a compliance argument with European processors and soap makers.',
    'The restriction on certain cyclosiloxanes opens a demand axis, conditional and with its own qualification.',
  ],
  m: [
    'The media attention cycle sits between peak and ebb: among the social media items analysed, dermatologists recommend tallow in 7% of cases.',
    'The trend that excludes animal ingredients by definition is the fastest-growing segment.',
    'Reputational contamination from indefensible third-party claims and from attribution errors circulating in the literature.',
    'Nomenclature entries for tallow derivatives are already listed for cosmetic use: the perimeter is not virgin even on the naming side.',
    'A competitor could publish primary data first, erasing the advantage of the gap.',
  ],
};

const pivots = [
  { t: 'The lipid qualification platform, independent of tallow', d: 'Spectroscopy plus chemometrics plus predictive models applies to any lipid. It is the most transferable asset and the most defensible repositioning.' },
  { t: 'The traceability infrastructure on other raw materials from the same district', d: 'The Passport and the chain-of-custody logic apply to other by-products of the same territory.' },
  { t: 'The evidence library as a standalone asset', d: 'Position papers, documentary due diligence, scientific positioning advice for other operators in the category. The audit of two attribution errors traced back to source makes this scenario more concrete than it previously appeared.' },
  { t: 'From producer to analytical service provider', d: 'Certifying third-party tallow batch by batch, competitors included, instead of producing it. This avoids the volume and price constraint entirely, and the fact that the prior art on fractionation is public strengthens it: if the process is not defensible, the qualification service is more so.' },
];
---
<OdeV2Layout title={m.title} description={m.description} lang={lang} active="investitori">
  <header class="pg">
    <p class="ode-eyebrow">Investors</p>
    <h1>The verdict, in two parts</h1>
    <p class="lede">
      An analysis that cannot conclude negatively is not an analysis. This page opens with the
      negative part of the verdict, because it is the part an investor would find anyway, and
      because the conditional part only holds if the first has been said.
    </p>
  </header>

  <div class="verdict">
    <div class="verdict-half verdict-half--no">
      <span class="verdict-k"><Finding kind="contro" lang={lang} /></span>
      <h2>As a tallow producer competing on volume, the project does not hold</h2>
      <p>
        The volume-versus-differential constraint is unresolved, the accessible market is smaller
        than the trend and cannot be sized, the attention cycle sits between peak and ebb, and the
        experimental programme needed to support competitive claims absorbs an unsustainable share
        of the capital. <strong>Presented that way, it should be stopped.</strong>
      </p>
    </div>
    <div class="verdict-half verdict-half--si">
      <span class="verdict-k"><Finding kind="pro" lang={lang} /></span>
      <h2>As a laboratory qualifying and certifying an ingredient batch by batch, the position is defensible</h2>
      <p>
        Supplier of a proprietary documentary and analytical package to a narrow set of European
        premium formulators, with the measurement platform as a transferable asset.
        <strong>Under four precise conditions</strong>, listed below.
      </p>
    </div>
  </div>
  <p class="note">
    <DataTag kind="fonte" label="Two-part verdict and four conditions. OdE research consolidation, part E.4." />
  </p>

  <Section n="1" title="The four conditions">
    <ol class="conds">
      <li><span class="c-n">01</span><p>That the three near-zero-cost checks come back positive: at least one formulator requests a sample, the documentary argument on non-palm provenance has commercial substance, and quotations confirm the orders of magnitude.</p></li>
      <li><span class="c-n">02</span><p>That the minimum or at most the intermediate scenario is accepted, keeping most of the capital for production, relationships and market, not for experiments.</p></li>
      <li><span class="c-n">03</span><p>That regulatory and reporting competence is acquired as targeted consultancy, because the need is discontinuous and the most critical missing competence is not technical but regulatory.</p></li>
      <li><span class="c-n">04</span><p>That a single defensible proprietary datum is generated <strong>before</strong> the full evidence library is disclosed. The most recent revision of the research pins down what it is: <strong>the datum is the composition of the release, not its rate</strong>. Rate tells you how much the material hydrolyses; composition tells you whether what it releases is harmful, neutral or beneficial. Only the second answers the objection an informed formulator would raise, and only the second is a datum nobody else holds.</p></li>
    </ol>
    <p class="note">
      These are conditions reachable with the available resources. They are not a list of good
      intentions: the fourth in particular is why <a href={r.evidenza}>Open evidence</a> publishes
      costs and stopping criteria but not protocols.
    </p>
  </Section>

  <Section n="2" title="The most important thing on this page">
    <div class="headline">
      <p class="headline-big">
        The decision to proceed or stop costs <strong>less than three thousand euros and ninety
        days</strong>.
      </p>
      <p class="headline-sub">
        A hundred thousand euros are not needed to find out whether the project is worth
        continuing. The package that makes a first serious technical conversation with a
        formulator credible is almost entirely documentary, and the market gate is decided on
        eight to ten qualified conversations. The correct posture is not "I must raise capital for
        experiments" but "I must spend a few thousand euros to learn whether more will be needed".
      </p>
    </div>
    <div class="grid">
      <StatCard value="1,000-3,000 €" caption="Cost of the documentary package for a first credible exploratory conversation: technical data sheet, fatty acid profile, declarations, supply chain history, sample." kind="bench" source="Standard documentary requirements for a new cosmetic ingredient supplier on the EU market, per the public reference guide for exporters (cbi.eu). OdE research consolidation, part C.4." />
      <StatCard value="90 days" caption="Horizon within which the three near-zero-cost checks and the market gate return an outcome." kind="stima" source="Ninety-day operating plan. OdE research consolidation, part F.1." />
      <StatCard value="8-10" caption="Qualified conversations with European premium formulators on which the market gate is decided." kind="stima" source="Market gate criterion, with the pass threshold set before execution. OdE research consolidation, part E.1." />
    </div>
  </Section>

  <Section n="3" title="The real numbers of the experimental programme">
    <p>
      The figure that governs the whole plan, and that had never been laid out before the
      research: the complete programme costs a share of the capital that has to be stated, not
      hidden.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th scope="col">Scenario</th><th scope="col">Cost</th><th scope="col">Share of capital</th>
            <th scope="col">Duration</th><th scope="col">What OdE could then state</th><th scope="col">Verdict</th>
          </tr>
        </thead>
        <tbody>
          {scenarios.map((s) => (
            <tr class:list={[s.k === 'Intermediate' && 'is-ode', s.k === 'Complete' && 'is-gap']}>
              <th scope="row">{s.k}<span class="s-what">{s.what}</span></th>
              <td class="num">{s.cost}</td><td class="num">{s.pct}</td><td class="num">{s.dur}</td>
              <td>{s.say}</td><td>{s.v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <DataTag kind="stima" label="Scenario composition reconstructed line by line, each item traced to its source row. No figure here is a quotation. OdE research consolidation, parts C.1, C.5 and C.5bis." />
      Percentages are computed on a reference capital of <strong>350,000 euros</strong>, confirmed
      by the client and consistent with all the calculations in the research. The site currently
      online states 300,000: the correct figure is this one.
    </p>
    <Callout tone="warn" title="How to read it, with nothing discounted">
      <p>
        The complete scenario alone absorbs <strong>between one third and more than two thirds of
        the capital</strong>, before any spending on production, formulation, people and market.
        It is unsustainable for a very small structure and must be excluded, absent additional
        capital or public co-funding.
      </p>
      <p>
        The intermediate scenario is the reasonable ceiling. The minimum scenario is the mandatory
        starting point and is almost entirely licence to operate plus documentation, that is, it
        does not produce competitive advantage: it produces the right to be in the market.
      </p>
    </Callout>
  </Section>

  <Section n="4" title="Strengths, weaknesses, opportunities and threats">
    <div class="swot">
      <div class="sw sw--f"><h3>Strengths</h3><ul>{swot.f.map((x) => <li>{x}</li>)}</ul></div>
      <div class="sw sw--d"><h3>Weaknesses</h3><ul>{swot.d.map((x) => <li>{x}</li>)}</ul></div>
      <div class="sw sw--o"><h3>Opportunities</h3><ul>{swot.o.map((x) => <li>{x}</li>)}</ul></div>
      <div class="sw sw--m"><h3>Threats</h3><ul>{swot.m.map((x) => <li>{x}</li>)}</ul></div>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Matrix built on the seven research tracks, each entry traced to its source track. OdE research consolidation, part B.1." />
    </p>
    <Callout tone="honest" title="The asymmetry worth reading, which is itself a result">
      <p>
        In the evidence library behind this page, <strong>the theses favourable to OdE are almost
        all supported by a single research track, while the unfavourable ones are often supported
        by three converging tracks</strong>. This asymmetry of evidential support should not be
        flattened: it means the good news is more fragile than the bad. The latest revision of
        the research <strong>slightly attenuates</strong> it, by adding independent support to
        three favourable theses, but does not reverse it.
      </p>
      <p>
        One operational consequence follows: the highest value-to-cost move is not an experiment,
        it is the documentary package taken to European premium formulators. It requires no
        clinical study, and the first leg of the verdict is decided there.
      </p>
    </Callout>
  </Section>

  <Section n="5" title="The moat cannot be the process">
    <p>
      This is the most recent restriction on the thesis, and it is unfavourable. The prior-art
      map shows that <strong>fractionation and refining of tallow are in the public
      domain</strong>: four patent families on fractionation and at least six on refining and
      deodorisation applicable to animal fats, the oldest expired decades ago.
      <DataTag kind="fonte" label="Prior-art mapping of USPTO patents on tallow fractionation and animal fat refining. OdE research consolidation v4.0, section C.6. It is a map, not an opinion: a freedom-to-operate assessment requires qualified patent counsel." />
    </p>
    <p class="ev-line"><Status kind="dimostrato" lang={lang} /> <Finding kind="contro" lang={lang} /></p>
    <div class="grid-2">
      <article class="fin">
        <h3>The favourable side</h3>
        <p>
          OdE has wide freedom to operate on fractionation and refining, with no infringement
          risk and no licence costs. And the hypothesis of correcting stickiness by fractionation
          has <strong>documented technical precedent</strong>: it is not a technological bet, it
          is the application of a known process.
        </p>
      </article>
      <article class="fin">
        <h3>The unfavourable side, which weighs more</h3>
        <p class="fin-c">
          <strong>Anyone can fractionate tallow</strong>, and the prior art already describes
          semisolid fractions suitable for cosmetic use. What remains defensible is the
          proprietary datum, the supply-chain dataset and the Passport as infrastructure.
          <strong>Not how it is made.</strong>
        </p>
      </article>
    </div>
    <Callout tone="warn" title="The consequence, put as a due diligence would put it">
      <p>
        If OdE presented itself as the holder of a distinctive process, <strong>the position
        would not survive a technical due diligence</strong>. We write it here because it is
        exactly the kind of thing an investor would find at the second meeting, and because a
        thesis that holds only while nobody checks is not a thesis.
      </p>
      <p>
        The other side is that this strengthens one of the repositionings in section 8: if the
        process is not defensible, the qualification service is more so.
      </p>
    </Callout>
  </Section>

  <Section n="6" title="Public funding changes the cost, not the verdict">
    <p>
      Two instruments are realistically accessible, and they are not equivalent.
    </p>
    <div class="grid-2">
      <article class="fin">
        <h3>Regional grant for innovative startups</h3>
        <p>
          Non-repayable grant up to 60% of eligible expenditure, extendable with bonuses.
          <strong>It explicitly names the use of external laboratories for research and
          testing</strong> among eligible expenses, which resolves the main uncertainty of the
          other instrument.
        </p>
        <p class="fin-c">
          Against it: the minimum project investment threshold sits above the intermediate
          scenario, selection is competitive with a cut-off, and at the date of the survey the
          window is closed pending the next edition.
        </p>
      </article>
      <article class="fin">
        <h3>National zero-interest instrument</h3>
        <p>
          Zero-interest loan, unsecured, up to 80% of eligible expenditure, with a rolling window
          and fast processing. It would bring the intermediate scenario's own-capital exposure down
          from roughly 16-26% to about 6%.
        </p>
        <p class="fin-c">
          Against it, decisively: <strong>in this region no non-repayable component is available,
          and the loan must be repaid in full even if a gate forces a stop</strong>; the
          eligibility of testing outsourced to commercial laboratories is not explicitly named in
          the official text; and it presupposes a status that has yet to be verified.
        </p>
      </article>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Synoptic table of instruments with body, form, intensity, critical requirement and window status at the consultation date. OdE research consolidation, parts D.1 and D.1bis." />
    </p>
    <Callout tone="warn" title="Deferred capital, not free capital">
      <p>
        The real advantage of a zero-interest loan is not the absence of interest: it is that
        exposure is spread over time while the proprietary datum is acquired immediately. But
        <strong>if the datum is negative, you have paid for a failed experiment and you also have
        to repay the loan</strong>, in instalments, for a decade. Add a debt on the balance sheet
        of a structure that will later need to raise equity, and a structural reporting burden
        that falls precisely on the competence already identified as the bottleneck.
      </p>
      <p>
        Public funding <strong>does not loosen any of the four conditions</strong>. The zero-cost
        checks remain the entry gate, and debt makes the fourth condition even more binding.
        <Status kind="costruzione" lang={lang} />
      </p>
    </Callout>
    <Callout tone="honest" title="Innovative-startup status is a goal, not a fact, and it depends on a question about the product">
      <p>
        Both instruments presuppose registration in the special section of the companies
        register. That registration is <strong>a stated goal of OdE</strong>, not a condition
        already secured, and the innovative asset put forward to support it is the artificial
        intelligence inside <a href={r.amsa}>AMSA</a>.
      </p>
      <p>
        The delicate part is that <strong>we do not yet know whether the use of artificial
        intelligence in AMSA is substantial or marginal</strong>. The question is technical
        before it is administrative: what does the artificial intelligence do that mature
        chemometrics would not do on its own, on this matrix and with the number of batches we
        will actually have. It is under assessment, and the answer is not written.
      </p>
      <p>
        <strong>We record the perverse incentive here, because it exists.</strong> A status
        carrying real tax benefits pushes towards answering yes to a technical question before
        measuring it. The internal rule in <a href={r.amsa}>AMSA</a> says the opposite, and it
        was written first: an advanced model that does not beat the chemometric baseline does not
        go into production. If the answer turns out to be "marginal", the correct way forward is
        to seek the classification on another basis or not to have it, not to rewrite the product
        around a requirement.
        <Status kind="scommessa" lang={lang} />
      </p>
    </Callout>
    <p class="note phline">
      <span class="ph">To be confirmed</span>
      Two distinct things remain open: whether the use of artificial intelligence in AMSA is
      substantial, which is the question above, and what the registration path looks like once
      the first has an answer. The tax incentives in the next section have the same prerequisite.
    </p>
  </Section>

  <Section n="7" title="Incentives for investors, subject to the same condition">
    <p>
      Italian law provides incentives for investing in the equity of innovative startups. The
      reliefs are real and significant, and they are <strong>all conditional on registration in
      the special section</strong>, which is the still-open goal of the previous section, subject
      to a technical question about the product. We report them with that premise, not without
      it: <strong>as of today none of these reliefs is available</strong>, and presenting them as
      secured would be exactly what this site holds against the market.
    </p>
    <div class="grid">
      <StatCard value="30%" caption="Income tax relief for individuals, on an annual investment cap, with a minimum three-year holding period." kind="fonte" source="Relief regime for investments in innovative startups, art. 29 of Decree-Law 179/2012 as amended. Rates and caps to be re-verified at publication date." />
      <StatCard value="65%" caption="Income tax relief under the de minimis regime, on a lower annual cap. Alternative to, and not cumulative with, the previous one." kind="fonte" source="Rate raised by Law 193/2024. To be re-verified at publication date." />
      <StatCard value="30%" caption="Deduction for corporate income tax payers investing in the equity." kind="fonte" source="Relief regime for investments in innovative startups. To be re-verified at publication date." />
    </div>
    <p class="note">
      There are also dedicated routes for non-EU investors, with investment thresholds
      differentiated by type. We provide them on request and with the verification date, because
      thresholds and requirements change.
      <DataTag kind="fonte" label="Italian investor visa programme, official MIMIT portal (investorvisa.mise.gov.it). Thresholds and requirements to be re-verified at publication date." />
      None of this is tax advice.
    </p>
  </Section>

  <Section n="8" title="If the main thesis failed">
    <p>
      Four repositionings enabled by assets already built, in order of readiness. They are not a
      rhetorical plan B: they are why capital invested in measurement is not lost even in the
      worst case on tallow.
    </p>
    <ol class="pivots">
      {pivots.map((p, i) => (
        <li><span class="p-n">{String(i + 1).padStart(2, '0')}</span><div><h3>{p.t}</h3><p>{p.d}</p></div></li>
      ))}
    </ol>
    <p class="note">
      <DataTag kind="fonte" label="Repositioning scenarios in order of readiness. OdE research consolidation, part E.3." />
      The research is blunt on this point: if the three zero-cost checks fail, the honest answer is
      to reposition on the measurement platform and the library, not to persist on tallow.
    </p>
  </Section>

  <Section n="9" title="What you should know before talking to us">
    <p class="measure">
      There are three things we cannot tell you and that you would find out anyway, so we say them
      here. There is no clinical evidence on the material. The market where our difference matters
      cannot be sized with public data. And the corporate status that conditions half the
      financial instruments on this page has yet to be verified.
    </p>
    <p class="measure">
      If the conversation still makes sense to you after that, it makes sense to us too.
    </p>
    <p class="contact">
      <a href="mailto:mm@matteomartignoni.com?subject=OdE%20-%20investor%20conversation">mm@matteomartignoni.com</a>
    </p>
    <p class="note phline">
      <span class="ph">To be confirmed</span>
      The site currently carries no founder profile. If the credibility of the person is part of
      what an investor assesses, that section needs writing and needs material.
    </p>
  </Section>

  <ReadNext
    lang={lang}
    links={[
      { href: r.posizione, label: 'Position: the structural constraint in full' },
      { href: r.audit, label: 'The Audit: the basis of the verdict' },
      { href: r.evidenza, label: 'Open evidence: the gates and stopping criteria' },
    ]}
  />
</OdeV2Layout>

<style>
  .verdict { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1.1rem; margin: 0.5rem 0 0.8rem; }
  .verdict-half { border-radius: var(--ode-radius); padding: 1.4rem 1.5rem; border: 1px solid var(--rule); }
  .verdict-half--no { background: var(--pink-soft); border-color: var(--pink); }
  .verdict-half--si { background: var(--green-soft); border-color: var(--green-border); }
  .verdict-k { display: block; margin-bottom: 0.7rem; }
  .verdict-half h2 { font-size: 1.15rem; font-weight: 500; line-height: 1.35; color: var(--ink); margin: 0 0 0.7rem; }
  .verdict-half p { margin: 0; font-size: 0.93rem; line-height: 1.6; color: var(--body); }

  .conds { list-style: none; margin: 1.2rem 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .conds li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1rem; align-items: baseline; }
  .c-n { font-family: var(--ode-font-mono); font-size: 0.95rem; color: var(--accent); }
  .conds p { margin: 0; font-size: 0.93rem; line-height: 1.6; color: var(--body); max-width: 42rem; }

  .headline {
    background: var(--panel-strong);
    border: 1px solid var(--green-border);
    border-radius: var(--ode-radius);
    padding: 1.5rem 1.7rem;
    margin: 1.2rem 0 1.4rem;
    max-width: 44rem;
  }
  .headline-big { margin: 0; font-size: clamp(1.15rem, 2.5vw, 1.5rem); line-height: 1.35; font-weight: 300; color: var(--ink); }
  .headline-big strong { font-weight: 500; }
  .headline-sub { margin: 0.9rem 0 0; font-size: 0.93rem; line-height: 1.6; color: var(--body); }

  .s-what { display: block; font-weight: 400; font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; line-height: 1.45; max-width: 16rem; }
  .is-gap td, .is-gap th { border-bottom-style: dashed; border-bottom-color: var(--ink); }

  .swot { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; margin: 1.3rem 0; }
