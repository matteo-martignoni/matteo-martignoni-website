---
import OdeV2Layout from '../../../layouts/OdeV2Layout.astro';
import Section from '../../../components/ode/Section.astro';
import DataTag from '../../../components/ode-v2/DataTag.astro';
import Status from '../../../components/ode-v2/Status.astro';
import Finding from '../../../components/ode-v2/Finding.astro';
import Callout from '../../../components/ode-v2/Callout.astro';
import ClaimTable from '../../../components/ode-v2/ClaimTable.astro';
import ReadNext from '../../../components/ode-v2/ReadNext.astro';
import { odeMeta, odeRoutes } from '../../../i18n/ode-v2';

const lang = 'en' as const;
const m = odeMeta[lang].audit;
const r = odeRoutes[lang];

const basins = [
  'PubMed', 'EMBASE', 'Europe PMC', 'Scopus', 'Web of Science', 'Google Scholar',
  'Semantic Scholar', 'ClinicalTrials.gov', 'CIR', 'CosIng', 'EUR-Lex', 'FAO Codex Alimentarius',
];

const corpus = [
  { g: 'A1', n: '0', what: 'Controlled studies on human skin in vivo, with instrumental measurement, adequate sample and an active comparator.', note: 'None.' },
  { g: 'A2', n: '0', what: 'Studies on human skin in vivo with instrumental measurement but weaker design or sample.', note: 'None.' },
  { g: 'B1', n: '0', what: 'Human skin ex vivo with instrumental measurement.', note: 'None on animal fat.' },
  { g: 'B2', n: '4', what: 'Animal models and in vitro work.', note: 'One lard study on rat oedema, one seven-component blend on mice, one in vitro study on keratinocytes, and one study on 95 piglets in which pure lard produced no benefit at all.' },
  { g: 'C', n: '2', what: 'Human outcome, self-reported, verified.', note: 'Two studies on emulsions of interesterified ovine tallow blended with a vegetable oil, 83 and 78 participants, reported rather than instrumental outcome, from the same research group.' },
  { g: 'C', n: '2', what: 'Outcome attributed but not verifiable from abstracts alone.', note: 'Two studies cited by the review as carrying a moisturising outcome, whose attribution could not be verified.' },
];

const errors = [
  {
    t: 'A plant fat read as an animal one',
    what: 'Esters of Engkabang fat, that is, the fat of Shorea stenoptera, are described as derived mainly from tallow, and their hydration data are reported as evidence of tallow benefit.',
    why: 'Engkabang is a plant fat. The consequence is stark: the only quantitative hydration figure in the entire review, the progression from 4.7% to 47.2% between 30 and 180 minutes, does not concern tallow and is not a benchmark for tallow. That figure circulates.',
    src: 'Abd Rahman et al. 2011, Bioresour Technol, DOI 10.1016/j.biortech.2010.10.034. Verified against full text, research track 5 v3.0 section 6.9.1.',
  },
  {
    t: 'A herbicide surfactant read as tallow',
    what: 'Among the studies on the adverse effects of tallow are works on ethoxylated tallow amines, the surfactants used in glyphosate herbicide formulations.',
    why: 'Ethoxylated tallow amines are derived from tallow by amination and ethoxylation: they are cationic surfactants, and they share neither the structure nor the toxicological behaviour of the triglyceride. Two circulating statements follow from this: that tallow is a sensitiser according to a given assay, and that tallow is not safe for marine ecosystems. Both measure a different molecule.',
    src: 'Lindberg et al. 2020, J Proteomics, DOI 10.1016/j.jprot.2020.103647. Research track 6 v2, section 6 and record sheet R23.',
  },
  {
    t: 'A systemic route read as topical application',
    what: 'Among the included studies are an intravenous infusion of a tallow emulsion in dairy cattle and an abomasal infusion, plus a triglyceride emulsion given intravenously.',
    why: 'These are systemic routes of administration. They say nothing about how a lipid behaves when applied to skin, which is the question the review sets out to answer.',
    src: 'Pires et al. 2007 and Brickner et al. 2009, mapped in the audit table of research track 5 v3.0, section 6.9.',
  },
  {
    t: 'A compositional source that disagrees with direct characterisations',
    what: 'The composition of tallow and its vitamin content, that is, the whole biocompatibility argument, are attributed to a study on food tallow thermally oxidised at 180 °C and fed to rabbits.',
    why: 'The fatty acid profile reported there is anomalous: linoleic acid between 18.7 and 23.7 g per 100 g, with no oleic acid among the majority species. Two gas-chromatographic characterisations read in full give linoleic acid at 0.50% and 1.3%. The discrepancy is roughly fortyfold.',
    src: 'Zeb & Akbar 2018, DOI 10.1155/2018/7408370, compared with Limmatvapirat 2021 (DOI 10.7324/JAPS.2021.110903) and Kowalska 2020 (DOI 10.3390/biom10010115). Research track 5 v3.0, section 6.9.1.',
  },
];

const claims = [
  {
    claim: '"Similar to sebum or to human skin lipids"',
    says: 'Compositional similarity to human sebum, often in superlative form against entire ingredient classes.',
    evidence: 'True for the triglyceride fraction only. Human sebum contains roughly 25% wax esters and 12-15% squalene, both absent from tallow, and its characteristic fatty acid is unique to the human species.',
    ok: 'parziale' as const,
    criterion: 'Truthfulness; evidential support',
  },
  {
    claim: '"Rich in vitamins A, D, E, K"',
    says: 'Composition, with an implied benefit.',
    evidence: 'Present in traces, never standardised. The compositional fact does not support the functional implication.',
    ok: 'parziale' as const,
    criterion: 'Evidential support',
  },
  {
    claim: '"Strengthens the skin barrier"',
    says: 'Repair of barrier function.',
    evidence: 'Tallow is classified as an emollient. It supplies neither ceramides nor cholesterol in physiological ratio, and no instrumental study documents a repair effect.',
    ok: 'no' as const,
    criterion: 'Truthfulness',
  },
  {
    claim: '"Treats acne, eczema or dermatitis"',
    says: 'Treatment of named pathological conditions.',
    evidence: 'None. And a statement describing the treatment of a disease risks being reclassified as a medicinal claim.',
    ok: 'no' as const,
    criterion: 'Fairness; the medicinal boundary',
  },
  {
    claim: '"Non-comedogenic", or "comedogenic rating 2"',
    says: 'A value on a comedogenicity scale.',
    evidence: 'The value is extrapolated from data on free fatty acids and their esters of monohydric alcohols, that is, from molecules in a chemical form different from the one present in tallow. It has never been measured on tallow.',
    ok: 'no' as const,
    criterion: 'Evidential support',
  },
  {
    claim: '"Natural and ancestral"',
    says: 'Origin and tradition of use.',
    evidence: 'Not evidential. It describes a provenance, not a performance, and must not be used to imply one.',
    ok: 'neutra' as const,
    criterion: 'Fairness; informed choice',
  },
];

const chain = [
  { n: '1', t: 'The farming practice produces a different animal', ev: 'Animal science literature on grass-fed systems', g: 'Medium', v: 'Partly holds' },
  { n: '2', t: 'That animal produces a fat of different composition', ev: 'Documented fatty acid and CLA profiles', g: 'Good', v: 'Holds on the compositional datum' },
  { n: '3', t: 'That composition produces a superior cutaneous outcome', ev: 'No instrumental study', g: 'None', v: 'Breaks here' },
  { n: '4', t: 'All of it entails an environmental benefit', ev: 'Contested literature on regenerative grazing', g: 'Weak and contested', v: 'Holds only in part' },
];

const bar = [
  { i: 'Virgin coconut oil', d: 'Double-blind controlled trial, atopic dermatitis in adults', o: 'S. aureus colonisation, 5% versus 50% (RR 0.10; p = 0.0028); objective SCORAD p = 0.004' },
  { i: 'Argan oil', d: 'Randomised controlled trial, postmenopausal women', o: 'Skin elasticity R2, R5, R7 at p < 0.001; resilience p = 0.002 for the topical arm' },
  { i: 'Jojoba oil', d: 'Experimental models', o: 'Significant reduction in TNF-alpha and IL-6' },
  { i: 'Beef tallow', d: 'none', o: 'no data' },
];
---
<OdeV2Layout title={m.title} description={m.description} lang={lang} active="audit">
  <header class="pg">
    <p class="ode-eyebrow">The Audit</p>
    <h1>What we verified, and how</h1>
    <p class="lede">
      This is the page that explains why we believe we are entitled to talk about this material.
      It contains no statements about what tallow does to skin: it contains the result of months
      spent trying to break the idea before building a company on it.
    </p>
    <p class="sub">
      Everything below can be verified by anyone with access to the literature, in an afternoon.
      That is its main property.
    </p>
  </header>

  <Section n="1" title="The evidence gap">
    <p>
      The number of studies measuring an instrumental cutaneous outcome for beef tallow applied
      as such to human skin is <strong>zero</strong>. No randomised trial, no quantitative
      measurement of transepidermal water loss, no controlled corneometric data, no direct
      comparison against an active comparator.
      <DataTag kind="fonte" label="Gap verified by searching twelve basins: PubMed, EMBASE, Europe PMC, Scopus, Web of Science, Google Scholar, Semantic Scholar, ClinicalTrials.gov, CIR, CosIng, EUR-Lex and the FAO Codex Alimentarius. Targeted searches in Polish, Russian, Chinese, Japanese and Turkish in addition to English. Research track 5 v3.0, sections 1.3 and 8." />
    </p>
    <p class="ev-line"><Status kind="lacuna" lang={lang} /> <Finding kind="contro" lang={lang} /></p>

    <p class="measure">
      A gap is not an absence of research: it is a negative result, and as such it has to carry
      the basins searched and the languages covered. These are the twelve basins.
    </p>
    <ul class="basins">{basins.map((b) => <li>{b}</li>)}</ul>
    <p class="note">
      Plus targeted searches in Polish, Russian, Chinese, Japanese and Turkish, in addition to
      English. Polish returned commercial material only; Russian, an anecdotal tradition; Chinese,
      clinical sources advising against lard on burns for infection risk; Japanese, fat appearing
      only as an oil base, that is, as a vehicle and not as an active.
    </p>

    <h3 class="sub-h">What actually exists, once cleaned up</h3>
    <p class="measure">
      The evidential core amounts to eight records. None of them is pure beef tallow on human
      skin with instrumental measurement.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th scope="col">Grade</th><th scope="col">N</th><th scope="col">What it would be</th><th scope="col">What there is</th></tr>
        </thead>
        <tbody>
          {corpus.map((c) => (
            <tr><th scope="row" class="num">{c.g}</th><td class="num">{c.n}</td><td>{c.what}</td><td>{c.note}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Grade distribution recomputed record by record. Research track 5 v3.0, sections 3.1 and 4; confirmed in track 1 section 7, track 3 v4 section 2 and track 6 v2 section 2.1." />
      The grading scale is the one used throughout the library: A1 is a controlled study on human
      skin in vivo with instrumental measurement and an active comparator; D is a commercial
      source with no evidential value.
    </p>

    <Callout tone="honest" title="The most uncomfortable result in this section">
      <p>
        Among the four B2 records, one has a <strong>negative outcome</strong>: in 95 piglets,
        pure lard used as a comparator arm on castration wounds produced no healing benefit, and
        fungal colonisation matched the untreated control.
        <DataTag kind="fonte" label="Prokop et al. 2022, Planta Med 88:300-312, DOI 10.1055/a-1646-2959. Abstract access. Research track 5 v3.0, sections 5 and 13.3." />
      </p>
      <p>
        We report it in full and with its correct weighting: the setting is an open surgical
        wound, not intact skin, so the result firmly excludes wound care and dressing from the
        claimable perimeter and says little about cosmetic use. But it is a study with a
        comparator, a control and a decent sample, and it belongs on the table.
      </p>
    </Callout>
  </Section>

  <Section n="2" title="The audit of the most cited review">
    <p>
      The document the field cites when tallow and skin are discussed is a 2024 scoping review.
      It screened 147 studies and included 19, across two databases only, and it states that
      limit itself. Its main conclusion, that no randomised trial of tallow left on human skin
      exists, is the same one we reached independently.
      <DataTag kind="fonte" label="Russell MF, Sandhu M, Vail M, Haran C, Batool U, Leo J. Tallow, Rendered Animal Fat, and Its Biocompatibility With Skin: A Scoping Review. Cureus 2024;16(5):e60981. DOI 10.7759/cureus.60981. PRISMA-ScR pathway verified against full text." />
    </p>

    <Callout tone="note" title="How to read this section">
      <p>
        What follows is a documentary observation, not an accusation. We are not interested in
        anyone's carelessness: we are interested in what this says about the state of the field.
        The document everyone cites is one nobody has audited. That is not a gap in the
        literature. That is the absence of a literature.
      </p>
      <p>
        Every entry below can be verified by comparing the review with the primary study it
        cites. We name which one.
      </p>
    </Callout>

    <ol class="findings">
      {errors.map((e, i) => (
        <li>
          <span class="f-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="f-t">{e.t}</span>
          <p class="f-b">{e.what}</p>
          <p class="f-b"><strong>Why it matters.</strong> {e.why}</p>
          <p class="f-b note"><DataTag kind="fonte" label={e.src} /> Primary source and verification reference in the footnote.</p>
        </li>
      ))}
    </ol>

    <h3 class="sub-h">The verdict of the audit</h3>
    <p class="measure">
      The review's general conclusion holds, but despite the method rather than because of it.
      Of the 19 included studies, six bear on the topical application of a triglyceride animal
      fat, and of those one measures no biological outcome at all. The real corpus with a
      cutaneous outcome is <strong>five studies out of nineteen declared</strong>.
      <DataTag kind="fonte" label="Entry-by-entry reclassification of the 19 included studies, research track 5 v3.0, sections 6.9 and 6.9.4. [DERIVED CALCULATION]" />
    </p>

    <Callout tone="warn" title="The review's conclusion that is unfavourable to us">
      <p>
        In its conclusions the same review states that other compounds studied in the comparative
        work, in particular pumpkin seed oil and linoleic acid, offer moisturising and emollient
        benefits <strong>superior</strong> to tallow. It further reports that tallow is
        significantly stickier than pumpkin seed oil, which may discourage application, and that
        it leaves a surface oily film potentially unwelcome on oily or acne-prone skin.
      </p>
      <p>
        It has to be reported as it stands. An audit that only corrects in the direction that
        suits its author is not an audit.
      </p>
    </Callout>
  </Section>

  <Section n="3" title="The claims that do not hold">
    <p>
      This is a taxonomy of the statements circulating in the category, assessed against the
      European common criteria for the justification of cosmetic claims. It assesses
      <strong>the statements, never who makes them</strong>: no operator, brand or author is
      named, and no intent is attributed to anyone.
      <DataTag kind="fonte" label="Regulation (EU) 655/2013, common criteria for the justification of claims used in relation to cosmetic products. Taxonomy built in research track 7 v2, section 7." />
    </p>
    <ClaimTable rows={claims} lang={lang} />
    <Callout tone="honest" title="The rule this table imposes on us">
      <p>
        A site that publishes a taxonomy of indefensible claims cannot use any of them. None of
        the six rows above appears anywhere else on this site, in any form and under any synonym.
        If you find one, it is a mistake and we would like to hear about it.
      </p>
    </Callout>

    <h3 class="sub-h">The context in which these claims circulate</h3>
    <p class="measure">
      A cross-sectional analysis published in a peer-reviewed journal examined 200 social media
      items, fifty from each of four platforms.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th scope="col">Measure</th><th scope="col">Value</th></tr></thead>
        <tbody>
          <tr><th scope="row">Items recommending tallow</th><td class="num">82%</td></tr>
          <tr><th scope="row">Items with declarable financial bias</th><td class="num">61%</td></tr>
          <tr><th scope="row">Recommendation rate among beauty and skincare brand accounts</th><td class="num">96%</td></tr>
          <tr><th scope="row">Recommendation rate among dermatologists</th><td class="num">7%</td></tr>
          <tr><th scope="row">Items citing a scientific source</th><td class="num">16% of videos on one platform, 0% on two others</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Almatroud L, Choi S, Libson K, Ashack K. Beef Tallow-Based Skincare Claims in Social Media. J Cosmet Dermatol 2025;24(12):e70544. DOI 10.1111/jocd.70544. Taken up in research track 5 v3.0 section 6.1 and track 7 v2 section 7. Reading note: our two internal syntheses phrase the 96% and the 7% differently, either as shares of the promoter population or as recommendation rates per category. Since 96 plus 7 exceeds 100, only the second reading is arithmetically coherent, and it is the one adopted here. To be re-verified against the primary text before any external use." />
      The same work finds that financial bias significantly increases the probability of
      recommending tallow, and that per platform the share of items with a commercial interest
      reaches 92%. The most cited conditions are acne, eczema and psoriasis, that is, three
      diseases.
    </p>
    <p class="note">
      This is the noise from which a rigorous supplier inherits reputational risk, and the reason
      our differentiation cannot be a better claim: it has to be the absence of claims and the
      presence of data.
    </p>
  </Section>

  <Section n="4" title="The virtuous chain, and where it breaks">
    <p>
      The dominant rhetorical pattern of the category is a four-link chain. The strength of the
      first two links is used to make the third acceptable, and the third has no data. Seeing it
      clearly is how you avoid repeating it.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th scope="col">Link</th><th scope="col">Statement</th><th scope="col">Evidence</th><th scope="col">Grade</th><th scope="col">Verdict</th></tr>
        </thead>
        <tbody>
          {chain.map((c) => (
            <tr class:list={[c.n === '3' && 'is-break']}>
              <th scope="row" class="num">{c.n}</th><td>{c.t}</td><td>{c.ev}</td><td>{c.g}</td><td>{c.v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Analysis of the virtuous chain and its four links, research track 7 v2, section 8." />
    </p>

    <Callout tone="honest" title="Where this hits us">
      <p>
        Link 3 is undemonstrated for the market <strong>and for OdE</strong>. That supply-chain
        quality produces a superior cutaneous outcome cannot be shown with existing data, for us
        as for anyone else.
      </p>
      <p>
        Our advantage, if there is one, sits on links 1 and 2, that is, on documented traceability
        and composition, and on the fact that we measure and declare them batch by batch. We do
        not spend link 3 until it exists. What we do measure is in <a href={r.amsa}>AMSA</a>;
        what we would like to measure is in <a href={r.evidenza}>Open evidence</a>.
      </p>
    </Callout>
  </Section>

  <Section n="5" title="The evidential bar we have to clear">
    <p>
      The barrier to adoption of this material is not only cultural: it is evidential, and it can
      be quantified. The plant comparators tallow is measured against already have controlled
      studies with measured outcomes.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th scope="col">Ingredient</th><th scope="col">Design</th><th scope="col">Measured outcome</th></tr></thead>
        <tbody>
          {bar.map((b) => (
            <tr class:list={[b.i === 'Beef tallow' && 'is-gap']}>
              <th scope="row">{b.i}</th><td>{b.d}</td><td>{b.o}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Comparison of evidential thresholds reconstructed in research track 5 v3.0, section 6.10, from Sataray-Rodriguez et al. 2025, Dermis 5(3):39, DOI 10.35702/Derm.10039, read in full." />
    </p>
    <p class="measure">
      One operational consequence follows, and this site applies it everywhere:
      <strong>the experimental design is not a research option, it is a commercial
      prerequisite</strong>. Until it exists, the only honest thing we can sell is the
      qualification of the material, not its efficacy.
    </p>
  </Section>

  <ReadNext
    lang={lang}
    links={[
      { href: r.tesi, label: 'The Thesis: the parameter that decides' },
      { href: r.evidenza, label: 'Open evidence: what we want to measure' },
      { href: r.posizione, label: 'Position: where we can exist' },
    ]}
  />
</OdeV2Layout>

<style>
  .ev-line { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.2rem; }
  .sub-h { font-size: 1.05rem; font-weight: 500; color: var(--ink); margin: 2rem 0 0.7rem; }
  .basins { list-style: none; margin: 0.8rem 0 0.9rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .basins li {
    font-family: var(--ode-font-mono);
    font-size: 0.74rem;
    color: var(--ink);
    background: var(--pill);
    border: 1px solid var(--rule);
    border-radius: var(--ode-radius-sm);
    padding: 0.22rem 0.55rem;
  }
  .is-break td, .is-break th,
  .is-gap td, .is-gap th {
    background: transparent;
    border-bottom-style: dashed;
    border-bottom-color: var(--ink);
    color: var(--ink);
  }
  .is-break th, .is-gap th { font-weight: 500; }
</style>
