---
import OdeV2Layout from '../../../layouts/OdeV2Layout.astro';
import Section from '../../../components/ode-v2/Section.astro';
import NormRecord from '../../../components/ode-v2/NormRecord.astro';
import DataTag from '../../../components/ode-v2/DataTag.astro';
import Status from '../../../components/ode-v2/Status.astro';
import Finding from '../../../components/ode-v2/Finding.astro';
import Callout from '../../../components/ode-v2/Callout.astro';
import ReadNext from '../../../components/ode-v2/ReadNext.astro';
import { odeMeta, odeRoutes } from '../../../i18n/ode-v2';

const lang = 'en' as const;
const m = odeMeta[lang].normativa;
const r = odeRoutes[lang];

// Neutral labels: the old "why OdE wins" wording was too assertive for a
// documentary survey.
const L = {
  req: 'What it requires',
  perde: 'Who it catches',
  vince: 'What it means for OdE',
};

const vigenti = [
  {
    code: 'Reg. (EC) 1069/2009',
    title: 'Animal by-products',
    status: 'vigente' as const,
    statusLabel: 'In force',
    requisito: 'Fat for cosmetic use has to be Category 3 material, from animals inspected before and after slaughter. Article 33 marks the end point: once it reaches the cosmetic stage, the product leaves this regime and comes under the cosmetic regulation.',
    perde: 'Anyone who cannot document the exact point where the fat leaves the by-products regime. It is the main compliance bottleneck, and the competent veterinary authority has to sign off on it.',
    vince: 'An obligation, not an advantage: plant registration or approval, commercial paperwork, traceability. The Digital Lipid Passport is how OdE documents the handover, but the paperwork is owed either way.',
  },
  {
    code: 'Reg. (EU) 142/2011',
    title: 'Implementation and documentary traceability',
    status: 'vigente' as const,
    statusLabel: 'In force',
    requisito: 'Operating rules for the previous regulation: permitted uses, processing, commercial documents, registers and approval of the establishment by the competent authority.',
    vince: 'What it asks for in traceability largely overlaps with what AMSA produces for every batch. A useful overlap, not a differentiator: anyone operating lawfully has to produce it.',
  },
  {
    code: 'Reg. (EC) 1223/2009',
    title: 'European cosmetic regulation',
    status: 'vigente' as const,
    statusLabel: 'In force',
    requisito: 'Responsible person, product information file, safety report signed by a qualified assessor, nomenclature compliance, good manufacturing practice. Article 20 prohibits attributing characteristics the product does not possess.',
    perde: 'Anyone making efficacy claims they cannot support. Describe the treatment of a disease and you invite reclassification as a medicinal claim.',
    vince: 'For triglyceride tallow, the safety evidence is all inferred from constituents. There is no primary data. A solid dossier needs data on the real material, or a documented read-across the qualified assessor is willing to accept. Either way it is a cost of doing business that OdE carries regardless.',
  },
  {
    code: 'Reg. (EU) 655/2013',
    title: 'Common criteria for cosmetic claims',
    status: 'vigente' as const,
    statusLabel: 'In force',
    requisito: 'Six common criteria: legal compliance, truthfulness, evidential support, honesty, fairness and informed decision making. Every claim must be justifiable with adequate evidence.',
    perde: 'A good deal of what is currently said about this material would not survive these criteria, especially on evidential support and truthfulness.',
    vince: 'It is the yardstick behind the claim table published in the Audit, and the reason this site uses none of the claims on it. Hand a formulator an honest audit of the category and you stand out without claiming anything extra.',
  },
  {
    code: 'Codex CXS 211-1999',
    title: 'Standard for named animal fats',
    status: 'vigente' as const,
    statusLabel: 'Reference',
    requisito: 'Commercial quality limits: peroxide value not above 10 meq O₂/kg; acid value not above 2.5 mg KOH/g for edible tallow and 1.3 for pure rendered lard. Plus comparative physical parameters.',
    vince: 'We anchor the Passport thresholds to it, and we can, because it is standardised and auditable. Read it for what it is, though: a food-grade trading threshold, not a skin safety one. Nobody has ever tied these limits to anything that happens on skin.',
  },
  {
    code: 'ISO 22716 and sector GMP',
    title: 'Good manufacturing practice',
    status: 'vigente' as const,
    statusLabel: 'Standard',
    requisito: 'Good manufacturing practice for cosmetics and cosmetic ingredients, with strong emphasis on batch traceability.',
    vince: 'These are the keys to the professional customer. The batch traceability they require is the same traceability OdE already produces, which cuts the marginal cost of complying without removing it.',
  },
];

const arrivo = [
  {
    code: 'Reg. (EU) 2023/1115 and 2025/2650',
    title: 'Deforestation: tallow is out of scope',
    status: 'arrivo' as const,
    statusLabel: 'Coming into application',
    requisito: 'For products in scope, whoever first places them on the market has to run due diligence and file a declaration with the plots geolocated. It bites from 30 December 2026 for large and medium operators, and for the micro and small ones already covered by the timber regulation, and from 30 June 2027 for the remaining micro and small operators.',
    perde: 'Anyone placing palm-derived fatty acids, glycerol or fatty alcohols on the market, and from 30 December 2027 palm soap too.',
    vince: 'Strictly, nothing. The customs code for fats of bovine, ovine and caprine animals is not on the list, so tallow puts no obligation on OdE. What it does buy is a declaration that nothing here comes from palm oil: a field that costs us almost nothing and is worth more every year to a European customer. The three caveats that go with it are in the next section.',
  },
  {
    code: 'Reg. (EU) 2024/1781',
    title: 'Ecodesign and the Digital Product Passport',
    status: 'arrivo' as const,
    statusLabel: 'Scope to be defined',
    requisito: 'The regulation creates the Digital Product Passport, rolled out product group by product group through delegated acts.',
    perde: 'Impossible to say until the scope exists.',
    vince: 'Worth being exact here, because this one is easy to over-read. Delegated acts set the scope, and no delegated act we found covers cosmetic lipid ingredients. So the Lipid Passport is a voluntary differentiator today, and at most a future obligation. Presenting it as getting ahead of a certain requirement would be an inference dressed up as a fact.',
  },
  {
    code: 'Directive (EU) 2024/825',
    title: 'Environmental claims and commercial practices',
    status: 'arrivo' as const,
    statusLabel: 'Being transposed',
    requisito: 'Environmental claims will have to be verifiable and substantiated, with third-party certification counting for more.',
    vince: 'It pushes in the direction this site already runs in: state the source and the grade of every claim. It does not create demand for tallow, though, and we will not pretend it does.',
  },
  {
    code: 'REACH restriction on cyclosiloxanes',
    title: 'D4, D5 and D6 out from 6 June 2026',
    status: 'arrivo' as const,
    statusLabel: 'A conditional axis',
    requisito: 'A restriction on placing certain cyclosiloxanes on the market in rinse-off and leave-on cosmetics.',
    vince: 'It opens demand for substitutes to some silicones, but one caveat cuts it down sharply: the restriction covers cyclosiloxanes D4, D5 and D6, NOT dimethicone, which is what tallow actually gets compared with in most formulations. Saying silicones are banned and tallow replaces them would not hold up.',
  },
];

// Requirement or differentiator: the distinction that decides where to spend.
const params = [
  { p: 'Trace heavy metals', amb: 'Cosmetic', role: 'Requirement', why: 'Traces you cannot technically avoid, per the cosmetic regulation, with pharmacopoeia monographs covering the raw material.' },
  { p: 'Veterinary residues', amb: 'Supply chain and food', role: 'Requirement', why: 'They come with the livestock chain, and the legislation on veterinary medicine residues covers them.' },
  { p: 'Sensitisation dossier', amb: 'Cosmetic', role: 'Requirement', why: 'The safety report needs it, either through a battery of validated assays or a justified read-across. It buys no competitive advantage.' },
  { p: '3-MCPD and glycidyl esters', amb: 'Food, and only for vegetable, fish and marine oils', role: 'Differentiator', why: 'Terrestrial animal fat is not on the list of matrices. Monitoring these is positioning, not compliance. They are also the contaminants that matter most to our process, because they form during high temperature refining.' },
  { p: 'Polycyclic aromatic hydrocarbons', amb: 'Food', role: 'Differentiator', why: 'A strong process reason to watch them, and no binding cosmetic limit for this matrix.' },
  { p: 'Phthalates', amb: 'No limit for this matrix', role: 'Differentiator', why: 'Measurable, not regulated for this matrix.' },
  { p: 'Oxidative state', amb: 'No statutory cosmetic limit', role: 'Differentiator', why: 'This is the Oxidative Risk Score. No rule requires it, which is exactly what makes it positioning rather than a compliance cost.' },
];
---
<OdeV2Layout title={m.title} description={m.description} lang={lang} active="normativa">
  <header class="pg">
    <p class="ode-eyebrow">Regulation</p>
    <h1>The rules, read straight</h1>
    <p class="lede">
      The rules are friendlier than the noise around them suggests. Tallow is not banned in
      Europe. It needs paperwork as an animal by-product and a safety report signed by a qualified
      assessor. That is cost and process, not prohibition.
    </p>
    <p class="sub">
      What the rules do <strong>not</strong> allow is most of what is currently being said about
      this material.
    </p>
  </header>

  <Callout tone="note" title="What this page is, and what it is not">
    <p>
      What follows is <strong>a reading of the documents, not legal advice</strong>. Eligibility,
      whether reliefs can be combined, and questions of scope all need a professional to check
      them, and the safety report for a cosmetic product is a qualified assessor's job. Where an
      act has been adopted but not yet published in final form, we say so.
    </p>
    <p class="phline">
      <span class="ph">To be confirmed</span> This survey is current as of 27 August 2026, and the
      date needs moving every time the site is revised.
    </p>
  </Callout>

  <Section n="1" title="What applies today">
    <div class="norms">
      {vigenti.map((n) => (
        <NormRecord
          code={n.code}
          title={n.title}
          status={n.status}
          statusLabel={n.statusLabel}
          requisito={n.requisito}
          perde={n.perde}
          vince={n.vince}
          labelRequisito={L.req}
          labelPerde={L.perde}
          labelVince={L.vince}
        />
      ))}
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Texts consulted on EUR-Lex: Reg. (EC) 1069/2009, Reg. (EU) 142/2011, Reg. (EC) 1223/2009 and Reg. (EU) 655/2013." />
      <DataTag kind="fonte" label="FAO/WHO Codex Alimentarius, Standard for Named Animal Fats CXS 211-1999, Section 3 and Appendix, primary text." />
    </p>
  </Section>

  <Section n="2" title="What is coming, and what has no scope yet">
    <div class="norms">
      {arrivo.map((n) => (
        <NormRecord
          code={n.code}
          title={n.title}
          status={n.status}
          statusLabel={n.statusLabel}
          requisito={n.requisito}
          perde={n.perde}
          vince={n.vince}
          labelRequisito={L.req}
          labelPerde={L.perde}
          labelVince={L.vince}
        />
      ))}
    </div>
  </Section>

  <Section n="3" title="The deforestation asymmetry, and its three caveats">
    <p>
      This is the one piece of regulation that genuinely helps us, and it has to come with its
      caveats attached, or it turns into exactly the kind of leap the <a href={r.audit}>Audit</a>
      holds against everyone else.
    </p>
    <p><strong>The fact.</strong> The customs code for fats of bovine, ovine and caprine animals
      is not among the relevant products in Annex I to the deforestation regulation. Under the
      palm oil commodity, meanwhile, you already find palmitic and stearic acid, glycerol,
      industrial fatty acids and industrial fatty alcohols, and a delegated act adds oleic acid,
      specific fatty alcohols and, from 30 December 2027, soap. The same products from a non-palm
      source are not relevant products and carry no obligation at all.
      <DataTag kind="fonte" label="Check of Annex I to Reg. (EU) 2023/1115 as amended, with the linguistic qualification «synthesised using palm oil» and the definition of relevant product in art. 2 point 2. Application calendar deferred by Reg. (EU) 2025/2650. Track 7 v2, sec. 4.6.2." />
    </p>
    <p class="ev-line"><Status kind="dimostrato" lang={lang} /> <Finding kind="pro" lang={lang} /></p>

    <ol class="quals">
      <li>
        <span class="q-n">01</span>
        <div>
          <h3>It is a compliance argument, never one of environmental superiority</h3>
          <p>
            The legitimate version runs: palm is in scope, tallow is not, so a tallow derivative
            puts no due diligence burden on the customer. The version we will never build runs:
            palm is under environmental pressure, so tallow is more sustainable, so tallow is
            better. The second and third steps have no data behind them, and the second is
            arguable on the merits anyway, since tallow comes out of bovine livestock farming,
            which the climate literature treats as environmental pressure in its own right.
          </p>
        </div>
      </li>
      <li>
        <span class="q-n">02</span>
        <div>
          <h3>The exemption is not exclusive to tallow</h3>
          <p>
            Every raw material off the commodity list gets the same relief: coconut, shea,
            rapeseed, sunflower, and the minerals and synthetics too. Coconut in particular is the
            most direct substitute for palm in soap oleochemistry, it is out of scope, and it is
            vegan compatible. A formulator who wants the burden gone has an easier road than
            tallow, and will probably take it.
            <strong> This regulation creates demand for "non-palm", not for "traced" and not for
            "animal" either.</strong>
          </p>
        </div>
      </li>
      <li>
        <span class="q-n">03</span>
        <div>
          <h3>The dates and codes of the extended scope must be reconfirmed</h3>
          <p>
            The delegated act that extends the list has been adopted, but it still has a scrutiny
            period to clear, and the copy we read is marked provisional. Until final publication,
            the binding annex is the one in the base regulation. Use this argument commercially
            and that caveat travels with it.
            <Status kind="costruzione" lang={lang} />
          </p>
        </div>
      </li>
    </ol>

    <Callout tone="note" title="What it is actually worth, which is small and concrete">
      <p>
        A line in the commercial paperwork saying <strong>none of this comes from palm oil</strong>,
        sitting next to the spongiform encephalopathy declaration. It costs us almost nothing, it
        is worth more every year to a European customer, and above all it is a statement that is
        <strong>checkable and impossible to argue with</strong>, which is the opposite of the
        efficacy claims filling up this category.
      </p>
      <p>
        What we do not know is whether European processors experience the palm paperwork as a
        real problem or as routine. Finding out costs nothing but a few phone calls, and it should
        happen before we invest a euro in that direction. It sits among the gates in
        <a href={r.investitori}>Investors</a>.
      </p>
    </Callout>
  </Section>

  <Section n="4" title="Requirement or differentiator: where the money should go">
    <p>
      The most useful distinction on this page, and the one the market gets wrong most often. A
      requirement has to be met anyway and buys no advantage. A differentiator is optional and
      only pays if you tell somebody about it. Spending on compliance while thinking you are
      building a position is the most expensive mistake on the menu.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th scope="col">Parameter</th><th scope="col">Scope of the limit</th><th scope="col">Role</th><th scope="col">Why</th></tr>
        </thead>
        <tbody>
          {params.map((p) => (
            <tr>
              <th scope="row">{p.p}</th>
              <td>{p.amb}</td>
              <td><span class:list={['role', p.role === 'Requirement' ? 'role--req' : 'role--diff']}>{p.role}</span></td>
              <td>{p.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Scope verified: the relevant subsections of Reg. (EU) 2023/915 on 3-MCPD and glycidyl esters concern vegetable oils and fats, fish oils and oils of other marine organisms; animal fats of terrestrial origin do not appear among the listed matrices. Track 6 v2, sec. 5.10 and 8.3." />
    </p>
    <Callout tone="warn" title="The other side of that, which we should say">
      <p>
        Almost everything we measure is a differentiator rather than a requirement, and that is
        an advantage <strong>and a risk at once</strong>. An advantage, because monitoring it is
        positioning. A risk, because <strong>no limit does not mean no liability</strong>: in a
        dispute, the defence would rest entirely on the documentation OdE chose to produce, and on
        nothing else.
      </p>
      <p class="phline">
        <span class="ph">To be confirmed</span> One open decision changes this table: declare the
        material food grade and the food limits start applying wherever they exist. Settle it
        before the per-batch analytical plan is fixed.
      </p>
    </Callout>
  </Section>

  <ReadNext
    lang={lang}
    links={[
      { href: r.amsa, label: 'AMSA: what we measure, and under which standard' },
      { href: r.audit, label: 'The Audit: the claims that do not hold' },
      { href: r.posizione, label: 'Position: what this lever is really worth' },
    ]}
  />
</OdeV2Layout>

<style>
  .ev-line { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.2rem; }
  /* Una colonna sola: vedi la nota in NormRecord.astro. Su piu' colonne la
     prosa scendeva a una misura di trenta caratteri e le righe della griglia
     allineavano ogni scheda all'altezza della piu' lunga. */
  .norms { margin: 1.3rem 0; }
  .quals { list-style: none; margin: 1.4rem 0; padding: 0; display: flex; flex-direction: column; gap: 1.3rem; }
  .quals > li { display: grid; grid-template-columns: 2.6rem 1fr; gap: 1rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--rule); }
  .quals > li:last-child { border-bottom: 0; padding-bottom: 0; }
  .q-n { font-family: var(--ode-font-mono); font-size: 1.15rem; color: var(--accent); }
  .quals h3 { font-size: 1.02rem; font-weight: 500; color: var(--ink); margin: 0 0 0.45rem; line-height: 1.35; }
  .quals p { font-size: 0.93rem; line-height: 1.6; color: var(--body); margin: 0; max-width: 42rem; }
  .role {
    display: inline-block;
    font-family: var(--ode-font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.15em 0.45em;
    border-radius: 3px;
    white-space: nowrap;
  }
  .role--req { background: var(--lav-soft); color: var(--lav-ink); }
  .role--diff { background: var(--green-soft); color: var(--green); }
  .phline { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
</style>
