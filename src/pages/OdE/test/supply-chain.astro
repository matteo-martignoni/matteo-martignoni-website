---
import OdeV2Layout from '../../../layouts/OdeV2Layout.astro';
import Section from '../../../components/ode-v2/Section.astro';
import CowGlyph from '../../../components/ode/CowGlyph.astro';
import LifecycleFlow from '../../../components/ode/LifecycleFlow.astro';
import DataTag from '../../../components/ode-v2/DataTag.astro';
import Status from '../../../components/ode-v2/Status.astro';
import Finding from '../../../components/ode-v2/Finding.astro';
import Callout from '../../../components/ode-v2/Callout.astro';
import StatCard from '../../../components/ode-v2/StatCard.astro';
import ReadNext from '../../../components/ode-v2/ReadNext.astro';
import { odeMeta, odeRoutes } from '../../../i18n/ode-v2';

const lang = 'en' as const;
const m = odeMeta[lang].filiera;
const r = odeRoutes[lang];

const layers = [
  {
    k: 'Mandatory layer',
    glyph: 'calf' as const,
    title: 'Bovine registry',
    body: 'Every animal has an identity of its own: a double ear tag and a fourteen-character code that never changes from birth to death. Birth, movements and slaughter all go on the record, because the law says so.',
    refs: 'Reg. EU 2016/429, Implementing Reg. EU 2021/520, Legislative Decree 134/2022',
  },
  {
    k: 'Voluntary but binding layer',
    glyph: 'cow' as const,
    title: 'Designation specification',
    body: 'The specification ties the animal to a certified territory and a certified diet: local forage, silage banned outright, an area of five provinces and no more. It amounts to a nutritional identity card for the herd.',
    refs: 'Reg. EU 1151/2012, Implementing Reg. EU 2025/661',
  },
];

const gaps = [
  {
    n: '01',
    problema: 'Individual identity dissolves into the batch',
    body: 'The ear tag follows one animal as far as the slaughterhouse. At rendering, fat from several animals goes into the same lot, and from there the paperwork tracks a batch of rendered fat rather than an animal or a farm.',
    presidio: 'Chain of custody agreements with slaughterhouses and rendering plants that keep batches separated by origin and put their geography on paper.',
  },
  {
    n: '02',
    problema: 'The specification does not cover the fat',
    body: 'The designation covers milk and cheese. Nothing certifies the tallow. OdE cannot claim the designation for the fat, and cannot let anyone infer that the lipid is certified either.',
    presidio: 'Talk about where the material comes from, never about a certification the lipid does not have. Getting the wording right is the only credibility on offer here.',
  },
  {
    n: '03',
    problema: 'An end-of-career cow can leave earlier',
    body: 'A cow that has been milked can be sold on, fed differently and moved out of the district before slaughter, with every step still on the record. "From a dairy cow" is not the same thing as "fed to the specification right up to slaughter".',
    presidio: 'Word the claim tightly, and buy only from animals slaughtered straight out of the circuit.',
  },
  {
    n: '04',
    problema: 'The category must be proven, not asserted',
    body: 'Fat for cosmetic use has to be Category 3 material, from animals inspected before and after slaughter. Rendered Category 3 fats carry no chemical marker, which puts all the weight on keeping the paperwork separate.',
    presidio: 'Prove the category, and prove the separation, physical and documentary, across transport and processing: lot register, commercial document, plant approval.',
  },
  {
    n: '05',
    problema: 'No rule ties the batch to its origin',
    body: 'The hole between an animal with a legal identity and an anonymous lot stays open. No rule closes it, and nobody is obliged to close it.',
    presidio: 'The Digital Lipid Passport sits on a contractual and information system OdE builds, closing the hole regulation leaves open because we choose to. That is work we do, not something the territory hands us.',
  },
];

// Bovine versus porcine, four axes. None favours porcine.
const species = [
  { ax: 'Physical, occlusivity', bov: 'Solidification point 40-49 °C, iodine value 40-53. Semi-solid at 32 °C', sui: 'Solidification point 32-45 °C, iodine value 55-65. At the lower bound at 32 °C', v: 'Bovine favoured', g: 'Solid, primary source' },
  { ax: 'Barrier, acid value', bov: 'Reference limit 2.5 mg KOH/g; crude measured at 0.8', sui: 'Limit 1.3 mg KOH/g for pure rendered lard. No measured value found', v: 'Undetermined', g: 'Weak' },
  { ax: 'Direct cutaneous evidence', bov: 'No study on pure bovine', sui: 'Three primary studies, one with a negative result', v: 'Porcine has more studies, mixed result', g: 'Weak' },
  { ax: 'Cultural and commercial', bov: 'Hindu and Buddhist constraint', sui: 'Halal constraint, more burdensome in the destination markets of European cosmetics', v: 'Bovine favoured', g: 'Medium' },
];
---
<OdeV2Layout title={m.title} description={m.description} lang={lang} active="filiera">
  <header class="pg">
    <p class="ode-eyebrow">Supply chain</p>
    <h1>Provenance is an input, not a promise</h1>
    <p class="lede">
      The dairy cows of the Parmigiano Reggiano district are among the most documented and most
      regulated animals in Europe. That much is checkable, and this page uses it for exactly what
      it is worth: <strong>a documented input to qualification</strong>, not a claim that the
      product is better.
    </p>
    <p class="sub">
      The page also says, just as loudly, where that traceability breaks down and what provenance
      <em>does not</em> prove.
    </p>
  </header>

  <Section n="1" title="The double regulatory layer">
    <p>
      Two independent systems sit on top of the same animal. One is mandatory and fixes its
      identity. The other is voluntary but binding once you sign up, and it certifies territory
      and diet.
    </p>
    <div class="layers">
      {layers.map((l) => (
        <article class="layer">
          <div class="layer-head">
            <CowGlyph variant={l.glyph} size={40} class="layer-glyph" />
            <span class="layer-k">{l.k}</span>
          </div>
          <h3>{l.title}</h3>
          <p>{l.body}</p>
          <p class="layer-refs">{l.refs}</p>
        </article>
      ))}
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Consorzio del Parmigiano Reggiano, product specification and control plan. Regulatory texts consulted on EUR-Lex." />
    </p>
  </Section>

  <Section n="2" title="The life path, and where it breaks">
    <p>
      From birth to slaughter, traceability is strong and it is compulsory. Then, somewhere
      between the barn door and the batch of rendered fat, the animal's identity thins out and
      disappears. That gap is where OdE's work earns its keep, and it is also the exact point
      where a loose claim about traceability would stop being true.
    </p>
    <LifecycleFlow lang={lang} />
  </Section>

  <Section n="3" title="Where traceability breaks">
    <p>
      Five break points, each with the safeguard that deals with it. Naming them is the part of
      the job the market usually skips.
    </p>
    <div class="gaps">
      {gaps.map((gp) => (
        <article class="gap">
          <span class="gap-n">{gp.n}</span>
          <div class="gap-body">
            <h3>{gp.problema}</h3>
            <p>{gp.body}</p>
            <p class="gap-presidio"><span class="gap-pk">Safeguard</span> {gp.presidio}</p>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section n="4" title="Three things provenance does NOT demonstrate">
    <Callout tone="honest" title="First: it does not demonstrate a better cutaneous outcome">
      <p>
        Nobody has shown that a better supply chain produces a better outcome on skin.
        <strong>Not us, and not the rest of the market.</strong> It is the third link of the
        four-link chain in the <a href={r.audit}>Audit</a>, and it is the link with no data
        behind it.
      </p>
      <p>
        Our advantage, if we have one, sits on the earlier links: traceability and composition,
        documented and measured. We do not spend the third one before it exists.
        <Status kind="lacuna" lang={lang} /> <Finding kind="contro" lang={lang} />
      </p>
      <p>
        On <strong>link 2</strong>, though, something has turned up. Diet should shift the lipid
        profile measurably: fewer polyunsaturates on forage feeding, and therefore better
        oxidative stability. That would be the first place where provenance buys a property of
        the material rather than a story about it.
      </p>
      <p>
        <strong>We are not using it as an argument, for the reason that governs this whole
        site.</strong> The figure comes from a popular source that was never peer reviewed, and
        our own research says to re-check it on our own sample <em>before</em> it goes anywhere
        near communication. This site is communication. So it does not appear here as an
        advantage. It appears in <a href={r.evidenza}>Open questions</a> as a measurement waiting
        to be made, with the threshold already written down.
        <DataTag kind="bench" label="Compositional differential attributed to diet, reported by a popular source that is not peer reviewed and classified as level C by the library. OdE research consolidation v4.0, thesis 15 and still-open verification no. 9: to be re-verified on an OdE sample before any use in communication." />
      </p>
    </Callout>

    <Callout tone="honest" title="Second: it is not the same as deforestation compliance">
      <p>
        This is an easy slip to make in a sales document, so it is worth stating plainly. The
        European deforestation regulation wants geolocation of the plots or premises where the
        animals were kept, plus no deforestation after a given date. A protected designation of
        origin certifies something else entirely: a geographic area, a production specification,
        supply chain control. <strong>Two different pieces of paperwork, and they do not
        substitute for one another.</strong>
      </p>
      <p>
        The point is moot in practice anyway, because tallow falls outside the scope of that
        regulation. The full picture is in <a href={r.normativa}>Regulation</a>.
        <DataTag kind="fonte" label="Check of Annex I to Reg. (EU) 2023/1115: CN code 1502, fats of bovine, ovine and caprine animals, does not appear among the relevant products. Track 7 v2, sec. 4.6.2." />
      </p>
    </Callout>

    <Callout tone="honest" title="Third: it is not a certification of the lipid product">
      <p>
        The specification governs milk and cheese. The end of the animal's life, which is where
        tallow usually comes from, falls outside it: the control plan covers farms, dairies,
        ageing rooms, grating and portioning plants, while slaughterhouses and rendering plants
        answer to general legislation.
      </p>
      <p>
        Two things get confused here, and OdE sits squarely on the second. The specification bans
        tallow as something you <em>feed</em> the cows. It says nothing about tallow as something
        that <em>comes out</em> at the end of the animal's life.
      </p>
    </Callout>
  </Section>

  <Section n="5" title="The verifiable fact behind circularity">
    <p>
      In this category the circular economy story is nearly always just talk. There is one
      industry figure that supports it without any leaps, though, and it comes from the European
      association of processors.
    </p>
    <div class="grid">
      <StatCard value="2.3 million t" caption="Category 3 animal fat produced in Europe in 2025. Category 3 is the only grade eligible for feed and cosmetics." kind="fonte" source="EFPRA, 2025 data presented at the association congress, reported by the trade press. Track 7 v2, sec. 4.1." />
      <StatCard value="1.58 million t" caption="Share destined for biofuels in 2025, growing by 8.9%. It is the dominant destination, and it governs the upstream flow OdE depends on." kind="fonte" source="EFPRA, 2025 data. Track 7 v2, sec. 4.1." />
      <StatCard value="42,000 t" caption="Food and feed grade fats still sent to combustion in 2025, growing by 28%, with the trade association publicly asking whether that is the highest value destination." kind="fonte" source="EFPRA, 2025 data via the trade press. Track 7 v2, sec. 4.1." />
    </div>
    <p class="note">
      Usable material is being destroyed right now, and the volume is going up. That is the one
      place where the circularity argument touches a fact you can check. It says nothing about the
      product being better, and it is all we can honestly say on this axis.
      <Status kind="dimostrato" lang={lang} /> <Finding kind="pro" lang={lang} />
    </p>
    <p class="note">
      How much of that material reaches cosmetics <strong>cannot be pulled out</strong> of any
      public statistic we found. Why, in <a href={r.posizione}>Position</a>.
    </p>
  </Section>

  <Section n="6" title="Bovine or porcine: why bovine comes first">
    <p>
      The area gives us two streams, one from dairy cows and one from the pig circuit. They are
      not interchangeable, and the case for taking bovine first runs across four axes.
    </p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th scope="col">Axis</th><th scope="col">Bovine</th><th scope="col">Porcine</th><th scope="col">Verdict</th><th scope="col">Strength</th></tr>
        </thead>
        <tbody>
          {species.map((s) => (
            <tr><th scope="row">{s.ax}</th><td>{s.bov}</td><td>{s.sui}</td><td>{s.v}</td><td class="num">{s.g}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <DataTag kind="fonte" label="Comparative physical parameters from a primary source: FAO/WHO Codex Alimentarius CXS 211-1999, Section 3 and Appendix. Four-axis comparison in Track 5 v3.0, sec. 13." />
      Not one of the four favours porcine. That is not a case for dropping the porcine line. It is
      a case for taking it second.
    </p>

    <Callout tone="warn" title="An analytical gap specific to the porcine line">
      <p>
        We found no <strong>measured</strong> acid value for lard anywhere in the analytical
        literature, where tallow has two characterisations with a stated value. That gap has to be
        closed in house before any final decision, and it closes in a laboratory with samples from
        the real supply chain, not in a library.
        <Status kind="lacuna" lang={lang} />
      </p>
      <p>
        There is a practical consequence worth stating too, because it costs us money without
        buying us an argument. Selected back fat from the pig circuit falls into the trading class
        "pure rendered lard", whose acid value limit is <strong>1.3 mg KOH/g, not 2.5</strong>. If
        we run porcine, we have to hit the tighter limit, and that goes in the budget.
      </p>
    </Callout>
  </Section>

  <ReadNext
    lang={lang}
    links={[
      { href: r.amsa, label: 'AMSA: how the provenance data gets into the Passport' },
      { href: r.normativa, label: 'Regulation: what you are allowed to say' },
      { href: r.posizione, label: 'Position: and what any of it is worth' },
    ]}
  />
</OdeV2Layout>

<style>
  .layers { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.1rem; margin: 1.3rem 0; }
  .layer {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--ode-radius);
    padding: 1.2rem 1.3rem;
  }
  .layer-head { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.6rem; }
  .layer-head :global(.cow-glyph) { color: var(--accent); flex: 0 0 auto; }
  .layer-k {
    font-family: var(--ode-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .layer h3 { font-size: 1.05rem; font-weight: 500; color: var(--ink); margin: 0 0 0.5rem; }
  .layer p { font-size: 0.9rem; line-height: 1.55; color: var(--body); margin: 0; }
  .layer-refs {
    font-family: var(--ode-font-mono);
    font-size: 0.7rem !important;
    color: var(--muted) !important;
    margin-top: 0.7rem !important;
    line-height: 1.5 !important;
  }

  .gaps { display: flex; flex-direction: column; gap: 1.2rem; margin: 1.3rem 0; }
  .gap { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--rule); }
  .gap:last-child { border-bottom: 0; padding-bottom: 0; }
  .gap-n { font-family: var(--ode-font-mono); font-size: 1.1rem; color: var(--accent); }
  .gap h3 { font-size: 1rem; font-weight: 500; color: var(--ink); margin: 0 0 0.45rem; }
  .gap p { font-size: 0.9rem; line-height: 1.58; color: var(--body); margin: 0; max-width: 40rem; }
  .gap-presidio { margin-top: 0.6rem !important; }
  .gap-pk {
    display: inline-block;
    font-family: var(--ode-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green);
    background: var(--green-soft);
    border-radius: 3px;
    padding: 0.12em 0.4em;
    margin-right: 0.4rem;
  }
</style>
