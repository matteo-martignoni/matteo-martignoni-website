---
// Epistemic status of a CLAIM (distinct from DataTag, which classifies the
// provenance of a DATUM). Four values, aligned with the three epistemic
// categories of the research consolidation plus the one the Audit needs:
//
//   dimostrato  fatto stabilito con evidenza verificata
//   costruzione inferenza meccanicisticamente plausibile, non testata
//   scommessa   capacita emergente o ipotesi, non un fatto
//   lacuna      si e cercato in modo esaustivo nel bacino pertinente e non
//               si e trovato (esito negativo verificato)
//
// Rendered as an inline chip. Pass `block` for a standalone line above a
// paragraph.
import { type OdeLang } from '../../i18n/ode-v2';

type Kind = 'dimostrato' | 'costruzione' | 'scommessa' | 'lacuna';

interface Props {
  kind: Kind;
  lang?: OdeLang;
  block?: boolean;
}
const { kind, lang = 'it', block = false } = Astro.props;

const WORDS: Record<OdeLang, Record<Kind, string>> = {
  it: {
    dimostrato: 'Dimostrato',
    costruzione: 'Non ancora testato',
    scommessa: 'Scommessa',
    lacuna: 'Lacuna verificata',
  },
  en: {
    dimostrato: 'Established',
    costruzione: 'Not yet tested',
    scommessa: 'Bet',
    lacuna: 'Verified gap',
  },
};

const TITLES: Record<OdeLang, Record<Kind, string>> = {
  it: {
    dimostrato: 'Fatto stabilito con evidenza verificata e citabile.',
    costruzione: 'Inferenza meccanicisticamente plausibile, non ancora testata.',
    scommessa: 'Ipotesi o capacità emergente. Non un fatto.',
    lacuna: 'Abbiamo cercato in modo esaustivo nelle banche dati pertinenti e non abbiamo trovato nulla.',
  },
  en: {
    dimostrato: 'Established fact, backed by evidence we can cite.',
    costruzione: 'A mechanistically plausible inference. Nobody has tested it.',
    scommessa: 'A hypothesis, or a capability we are still building. Not a fact.',
    lacuna: 'We searched the relevant databases exhaustively and found nothing.',
  },
};
---
<span
  class:list={['st', `st--${kind}`, block && 'st--block']}
  title={TITLES[lang][kind]}
>{WORDS[lang][kind]}</span>

<style>
  .st {
    display: inline-block;
    font-family: var(--ode-font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.14em 0.5em;
    border-radius: 3px;
    border: 1px solid transparent;
    vertical-align: middle;
    white-space: nowrap;
  }
  .st--block { display: block; width: max-content; margin: 0 0 0.55rem; }

  /* Established: the positive-outcome green of the brand book. */
  .st--dimostrato { background: var(--green-soft); color: var(--green); border-color: var(--green-border); }
  /* Not yet tested: the grigio-blu diagram accent (process, volumes). */
  .st--costruzione { background: var(--lav-soft); color: var(--lav-ink); border-color: var(--lav-border); }
  /* Bet: the pesca diagram accent (highlight, input). */
  .st--scommessa { background: var(--pink-soft); color: var(--pink-ink); border-color: var(--pink); }
  /* Verified gap: no fill. An absence should not look like a result. */
  .st--lacuna { background: transparent; color: var(--ink); border-color: var(--ink); border-style: dashed; }
</style>
