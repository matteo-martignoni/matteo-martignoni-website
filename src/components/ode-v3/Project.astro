---
import Layout from '../../layouts/OdeV3Layout.astro';
const {lang='en'}=Astro.props;const it=lang==='it';const t=(a:string,b:string)=>it?b:a;const b='/OdE/test2'+(it?'/it':'');
---
<Layout title={t('People and project stage · OdE','Persone e stato del progetto · OdE')} lang={lang} editorial>
<header class="v3-page-head"><p class="v3-eyebrow">{t('The project / September 2026','Il progetto / Settembre 2026')}</p><h1>{t('Build the evidence. Then build on it.','Costruire le evidenze. Poi costruire su quelle.')}</h1><p class="v3-lede">{t('OdE is a development-stage project exploring batch qualification for animal-derived cosmetic lipids. The immediate work is to establish demand, agree the analytical pathway and generate useful data on real material.','OdE è un progetto in sviluppo che esplora la qualificazione di lotto dei lipidi di origine animale per la cosmetica. Il lavoro immediato è verificare la domanda, concordare il percorso analitico e generare dati utili sulla materia reale.')}</p></header>
<section class="v3-section"><div class="v3-section-top"><h2>{t('What exists. What comes next.','Cosa esiste. Cosa viene dopo.')}</h2><p>{t('This is a statement of project maturity based on the current research dossier. A published method or a working simulation does not establish a validated OdE service.','Questo quadro descrive la maturità del progetto sulla base del dossier di ricerca attuale. Un metodo pubblicato o una simulazione funzionante non dimostrano un servizio OdE validato.')}</p></div><div class="v3-table-wrap"><table class="v3-table"><thead><tr><th>{t('Area','Ambito')}</th><th>{t('Current position','Stato attuale')}</th><th>{t('Evidence needed next','Prossima verifica')}</th></tr></thead><tbody>{[
[t('Evidence review','Revisione delle evidenze'),t('Documented literature audit and a scoped account of the gaps.','Audit documentale della letteratura e descrizione delimitata delle lacune.'),t('Maintain the search record and update it as new studies appear.','Mantenere il registro di ricerca e aggiornarlo con i nuovi studi.')],
[t('Passport','Passaporto'),t('Proposed document structure and illustrative examples.','Struttura documentale proposta ed esempi illustrativi.'),t('Complete it from real reports and test usefulness with a formulator.','Compilarlo da referti reali e verificarne l’utilità con un formulatore.')],
[t('AMSA','AMSA'),t('Architecture and model development; demonstration interface.','Architettura e modelli in sviluppo; interfaccia dimostrativa.'),t('Validate predictions against reference methods and compare with a chemometric baseline.','Validare le previsioni sui metodi di riferimento e confrontarle con una base chemiometrica.')],
[t('Supply and delivery','Fornitura e realizzazione'),t('A proposed pathway; no named delivery partnership is confirmed on these pages.','Un percorso proposto; queste pagine non confermano accordi operativi nominativi.'),t('Agree material access, laboratory scope and specialist responsibilities.','Concordare accesso alla materia, perimetro di laboratorio e responsabilità specialistiche.')],
[t('Demand','Domanda'),t('A target audience and a defined market-test plan.','Un pubblico individuato e un piano di verifica commerciale.'),t('Document technical conversations, sample interest and willingness to pay.','Documentare confronti tecnici, interesse per campioni e disponibilità a pagare.')]
].map(r=><tr>{r.map((c,i)=>i===0?<th scope="row">{c}</th>:<td>{c}</td>)}</tr>)}</tbody></table></div></section>
<section class="v3-section"><div class="project-person"><img src="/images/home/portrait.png" width="1122" height="1402" loading="lazy" alt={t('Line portrait of Matteo Martignoni','Ritratto a linea di Matteo Martignoni')}/><div><p class="v3-eyebrow">{t('Project lead','Responsabile del progetto')}</p><h2>Matteo Martignoni</h2><p>{t('A background in beauty, brand and product development, including leadership roles at Aēsop in Melbourne and the establishment of its Italian business. That experience informs the commercial brief, supplier relationships and the commissioning of specialist work.','Un percorso nella cosmetica, nei marchi e nello sviluppo prodotto, con ruoli direttivi in Aēsop a Melbourne e l’avvio della sua attività italiana. Questa esperienza orienta il brief commerciale, le relazioni con i fornitori e il coordinamento del lavoro specialistico.')}</p><p>{t('The laboratory work requires lipid chemistry and analytical expertise. The animal by-product pathway requires specialist regulatory input. Those responsibilities should be assigned explicitly as the pilot is scoped.','Il lavoro di laboratorio richiede competenze di chimica lipidica e analitica. Il percorso dei sottoprodotti animali richiede supporto normativo specialistico. Queste responsabilità vanno assegnate esplicitamente nel definire il pilota.')}</p><p class="v3-small">{t('Career information is self-declared. The detailed background and its limits are in the investment dossier.','Le informazioni professionali sono autodichiarate. Il percorso dettagliato e i suoi limiti sono nel dossier di investimento.')}</p><a href={b+'/'+t('investment-notes','note-investimento')+'#sec-10'}>{t('Read the full background','Leggi il percorso completo')} →</a></div></div></section>
<section class="v3-band"><h2>{t('The next milestone is a useful real-world pilot.','La prossima tappa è un pilota utile sulla materia reale.')}</h2><div><p>{t('Agree a question with a formulator, secure the material and analytical work, and learn whether the document improves their evaluation. Broader research follows a separate decision about cost, relevance and demand.','Concordare una domanda con un formulatore, assicurare la materia e il lavoro analitico, capire se il documento migliora la sua valutazione. La ricerca più ampia segue una decisione separata su costi, rilevanza e domanda.')}</p><div class="v3-actions"><a class="v3-button" href={b+'/'+t('offer','proposta')}>{t('Explore the proposed pilot','Esplora il pilota proposto')} →</a></div></div></section>
<section class="v3-contact" id="contact"><p class="v3-eyebrow">{t('Contact','Contatti')}</p><h2>{t('Start with your question.','Parti dalla tua domanda.')}</h2><p>{t('For pilot discussions, research collaboration or the investment case, contact Matteo directly.','Per discutere un pilota, una collaborazione di ricerca o il caso di investimento, contatta direttamente Matteo.')}</p><a class="v3-button primary" href="mailto:mm@matteomartignoni.com?subject=OdE">mm@matteomartignoni.com ↗</a></section>
</Layout>
<style>.project-person{display:grid;grid-template-columns:1fr 2fr;gap:4rem;align-items:start}.project-person img{width:100%;height:auto;max-height:26rem;object-fit:contain;background:#e2eee6}.project-person h2{margin:0 0 1.5rem}@media(max-width:650px){.project-person{grid-template-columns:1fr;gap:2rem}.project-person img{max-width:12rem}}</style>
