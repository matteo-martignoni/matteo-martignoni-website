---
import Layout from '../../layouts/OdeV3Layout.astro';
const {lang='en'}=Astro.props;const it=lang==='it';const t=(a:string,b:string)=>it?b:a;const b='/OdE/test2'+(it?'/it':'');
const readings=[
['audit','audit',t('The evidence audit','L’audit delle evidenze'),t('Search scope, study classification, material mix-ups and the limits of common claims.','Perimetro della ricerca, classificazione degli studi, errori di matrice e limiti delle affermazioni diffuse.')],
['thesis','tesi',t('The material hypothesis','L’ipotesi sulla materia'),t('Acid value, chemical form and microbial hydrolysis. Why measurement does not settle skin outcomes.','Numero di acidità, forma chimica e idrolisi microbica. Perché misurare non risolve la domanda sugli esiti cutanei.')],
['amsa','amsa',t('The measurement approach','L’approccio alla misura'),t('Reference methods, the proposed platform and the validation it still needs.','Metodi di riferimento, piattaforma proposta e validazione ancora necessaria.')],
['supply-chain','filiera',t('Provenance and traceability','Provenienza e tracciabilità'),t('What origin documents can establish, where the chain breaks and the proposed safeguards.','Cosa dimostrano i documenti di origine, dove si interrompe la catena e le salvaguardie proposte.')],
['regulation','normativa',t('The regulatory dossier','Il dossier normativo'),t('The documentary review behind the project. Scope, dates and professional verification remain material.','La ricognizione documentale del progetto. Perimetro, date e verifica professionale restano determinanti.')],
['position','posizione',t('The commercial hypothesis','L’ipotesi commerciale'),t('The customer segment, alternative materials and the demand that has not yet been demonstrated.','Il segmento di clienti, le materie alternative e la domanda non ancora dimostrata.')],
['open-evidence','evidenza',t('The research programme','Il programma di ricerca'),t('Proposed experiments, internal cost estimates and decision criteria for review with research partners.','Esperimenti proposti, stime interne e criteri decisionali da esaminare con i partner scientifici.')],
['investment-notes','note-investimento',t('The investment dossier','Il dossier di investimento'),t('Detailed scenarios, risks, funding assumptions and the project lead’s background.','Scenari dettagliati, rischi, ipotesi di finanziamento e percorso del responsabile del progetto.')]
];
---
<Layout title={t('The evidence library · OdE','La biblioteca delle evidenze · OdE')} lang={lang} editorial>
<header class="v3-page-head"><p class="v3-eyebrow">{t('The evidence / A guide to the library','Le evidenze / Una guida alla biblioteca')}</p><h1>{t('Follow the claim back to its source.','Risali dall’affermazione alla fonte.')}</h1><p class="v3-lede">{t('The library explains the reasoning behind the project. It separates findings in published literature, OdE’s interpretations and questions that still require experiments.','La biblioteca spiega il ragionamento alla base del progetto. Distingue risultati della letteratura, interpretazioni di OdE e domande che richiedono ancora esperimenti.')}</p></header>
<section class="v3-section"><div class="v3-section-top"><h2>{t('The argument in three steps.','Il ragionamento in tre passaggi.')}</h2><p>{t('These steps are connected, but evidence for one does not establish the next.','I passaggi sono collegati, ma l’evidenza per uno non dimostra il successivo.')}</p></div><div class="v3-grid">{[
[t('A material can be characterised.','Una materia può essere caratterizzata.'),t('Standard analytical methods can describe composition and condition. Applying them reliably to an OdE workflow requires real samples and validation.','Metodi analitici standard possono descrivere composizione e stato. Applicarli in modo affidabile a un processo OdE richiede campioni reali e validazione.')],
[t('A dossier may help a buyer.','Un dossier può aiutare un acquirente.'),t('The commercial hypothesis is that useful, connected records improve ingredient evaluation. Customer conversations and pilots must establish that value.','L’ipotesi commerciale è che documenti utili e collegati migliorino la valutazione dell’ingrediente. Confronti con clienti e piloti devono verificarne il valore.')],
[t('Skin outcomes need their own evidence.','Gli esiti cutanei richiedono evidenze proprie.'),t('Composition, provenance and an oxidative score cannot establish efficacy or finished-product safety. Those questions require a separate assessment and appropriate studies.','Composizione, provenienza e un punteggio ossidativo non dimostrano efficacia o sicurezza del prodotto finito. Servono una valutazione separata e studi appropriati.')]
].map(([h,p],i)=><article class="v3-card"><span class="v3-num">0{i+1}</span><h3>{h}</h3><p>{p}</p></article>)}</div></section>
<aside class="v3-note"><p><strong>{t('The scoped evidence gap. ','La lacuna nel perimetro esaminato. ')}</strong>{t('The review reports no qualifying controlled human study of unmodified topical beef tallow with instrumental skin outcomes in the sources searched. Scopus and Web of Science were accessed through aggregators; several regional archives were not searched directly. This is not proof that no study exists anywhere.','La revisione non riporta studi controllati qualificanti sul sego bovino non modificato applicato alla pelle umana con esiti strumentali nelle fonti consultate. Scopus e Web of Science sono stati consultati tramite aggregatori; diversi archivi regionali non sono stati interrogati direttamente. Non è la prova che non esista alcuno studio.')}</p><a href={b+'/audit#sec-1'}>{t('Read the scope and exclusions','Leggi perimetro ed esclusioni')} →</a></aside>
<section class="v3-section"><div class="v3-section-top"><h2>{t('Choose your depth.','Scegli quanto approfondire.')}</h2><p>{t('The detailed dossiers retain the underlying argument and source notes. Their targets, estimates and proposed methods describe the research plan, not a ready-to-deliver service.','I dossier dettagliati conservano il ragionamento e le note sulle fonti. Obiettivi, stime e metodi proposti descrivono il piano di ricerca, non un servizio pronto all’erogazione.')}</p></div><div class="v3-grid two">{readings.map(([en,italian,h,p],i)=><article class="v3-card"><span class="v3-num">0{i+1} / {t('Dossier','Dossier')}</span><h3><a href={b+'/'+t(en,italian)}>{h} ↗</a></h3><p>{p}</p></article>)}</div></section>
<section class="v3-section"><div class="v3-section-top"><h2>{t('Two questions for every claim.','Due domande per ogni affermazione.')}</h2><p>{t('How strong is the evidence? And how far has OdE progressed? These are different dimensions.','Quanto è solida l’evidenza? E a che punto è OdE? Sono due dimensioni diverse.')}</p></div><div class="v3-grid two"><article class="v3-card"><h3>{t('Evidence status','Stato dell’evidenza')}</h3><p>{t('A source can support a finding, an internal calculation can support an estimate, and a mechanism can motivate a hypothesis. Study material, conditions and endpoints determine how far a result travels.','Una fonte può supportare un risultato, un calcolo interno una stima, un meccanismo un’ipotesi. Materia, condizioni ed esiti studiati determinano fino a dove il risultato è trasferibile.')}</p></article><article class="v3-card"><h3>{t('Project maturity','Maturità del progetto')}</h3><p>{t('A proposed method is not an implemented workflow. An illustrative interface is not a validated instrument. The project page states what remains to be demonstrated.','Un metodo proposto non è un processo implementato. Un’interfaccia illustrativa non è uno strumento validato. La pagina del progetto dichiara cosa resta da dimostrare.')}</p><a href={b+'/'+t('project','progetto')}>{t('Read the project status','Leggi lo stato del progetto')} →</a></article></div></section>
<section class="v3-contact"><h2>{t('Found evidence we should consider?','Hai trovato evidenze da considerare?')}</h2><p>{t('Send the reference and the specific claim it informs. Search records cited as internal research are not independently accessible through a public database homepage.','Invia il riferimento e l’affermazione specifica a cui si riferisce. I registri citati come ricerca interna non sono verificabili attraverso la homepage di una banca dati pubblica.')}</p><a class="v3-button" href="mailto:mm@matteomartignoni.com?subject=OdE%20evidence%20review">{t('Share a reference','Segnala un riferimento')} ↗</a></section>
</Layout>
