---
import Layout from '../../layouts/OdeV3Layout.astro';
const {lang='en'}=Astro.props;const it=lang==='it';const t=(a:string,b:string)=>it?b:a;const b='/OdE/test2'+(it?'/it':'');
const cases=[
{id:'baseline',name:t('Characterised example','Esempio caratterizzato'),batch:'DEMO–001',acid:'0.8',pv:'2.0',anv:'1.2',totox:'5.2',summary:t('Review against the buyer’s specification.','Confrontare con la specifica dell’acquirente.'),explanation:t('The illustrative panel is populated. These values alone do not establish suitability, safety or full conformity to a standard. Provenance, other analytical fields and the intended use still require review.','Il pannello illustrativo è compilato. Questi valori da soli non dimostrano idoneità, sicurezza o conformità completa a uno standard. Provenienza, altri parametri e uso previsto richiedono ancora una verifica.')},
{id:'review',name:t('Acidity needs review','Acidità da approfondire'),batch:'DEMO–002',acid:'4.1',pv:'2.0',anv:'1.2',totox:'5.2',summary:t('Hold the decision. Investigate the acidity.','Sospendere la decisione. Indagare l’acidità.'),explanation:t('The acid value is above the 2.5 mg KOH/g edible-tallow reference in the Codex appendix. Review the cause, confirm the result and agree the next step. The lower peroxide value does not cancel the acidity finding.','Il numero di acidità supera il riferimento di 2,5 mg KOH/g per il sego alimentare nell’appendice Codex. Esaminare la causa, confermare il risultato e concordare il passo successivo. Il valore di perossidi più basso non annulla il risultato sull’acidità.')},
{id:'missing',name:t('Incomplete evidence','Evidenze incomplete'),batch:'DEMO–003',acid:null,pv:'2.0',anv:null,totox:null,summary:t('Insufficient evidence to complete the review.','Evidenze insufficienti per completare la verifica.'),explanation:t('Acid value and p-anisidine are missing, so TOTOX cannot be calculated. A peroxide result alone cannot complete the analytical picture. Obtain the missing results and provenance records before deciding.','Mancano numero di acidità e p-anisidina, quindi TOTOX non è calcolabile. Il solo valore di perossidi non completa il quadro analitico. Acquisire risultati e documenti di provenienza mancanti prima di decidere.')}
];
const fao='https://www.fao.org/fao-who-codexalimentarius/sh-proxy/es/?lnk=1&url=https%253A%252F%252Fworkspace.fao.org%252Fsites%252Fcodex%252FStandards%252FCXS%2B211-1999%252FCXS_211e.pdf';
---
<Layout title={t('Explore a Digital Lipid Passport · OdE','Esplora un Passaporto Lipidico Digitale · OdE')} lang={lang} editorial>
<header class="v3-page-head"><p class="v3-eyebrow">{t('The proposed deliverable / Interactive specimen','Il documento previsto / Esempio interattivo')}</p><h1>{t('A document you can question.','Un documento da interrogare.')}</h1><p class="v3-lede">{t('Explore three invented cases to see how a Passport could organise information and support a technical review. Open each section to understand what it contributes and what evidence would be needed.','Esplora tre casi inventati per vedere come un Passaporto potrebbe organizzare le informazioni e supportare una verifica tecnica. Apri ogni sezione per capire cosa aggiunge e quali evidenze servirebbero.')}</p></header>
<div class="passport-disclaimer"><strong>{t('Illustrative data only.','Solo dati illustrativi.')}</strong> {t('Every batch and value below is invented for this example. No laboratory report, supplier record or certificate has been issued for these cases.','Ogni lotto e valore qui sotto è inventato per questo esempio. Per questi casi non è stato emesso alcun referto, documento di fornitura o certificato.')}</div>
<div class="passport-controls" hidden><p class="v3-eyebrow" id="scenario-label">{t('Choose a case','Scegli un caso')}</p><div class="passport-buttons" role="group" aria-labelledby="scenario-label">{cases.map((c,i)=><button type="button" data-case={c.id} aria-pressed={i===0?'true':'false'} aria-controls={'case-'+c.id}>{c.name}</button>)}</div></div>
<p class="passport-announcement" aria-live="polite" aria-atomic="true"></p>
<div class="passport-layout"><div class="passport-pages">{cases.map(c=><article id={'case-'+c.id} class="passport-page" aria-label={c.name}>
<div class="passport-top"><div><p class="v3-eyebrow">OdE / {c.batch}</p><h2>Digital Lipid Passport</h2><p>{c.name}</p></div><span class="passport-stamp">{t('ILLUSTRATIVE\nNOT A CERTIFICATE','ILLUSTRATIVO\nNON È UN CERTIFICATO')}</span></div>
<div class:list={['passport-decision',c.id]}><span class="v3-doc-label">{t('Proposed review outcome','Esito proposto della verifica')}</span><h3>{c.summary}</h3><p>{c.explanation}</p></div>
<div class="passport-metrics"><div><span>{t('Acid value','Numero di acidità')}</span><strong>{c.acid??'—'}</strong><small>{c.acid?'mg KOH/g':t('Not available','Non disponibile')}</small></div><div><span>{t('Peroxide value','Numero di perossidi')}</span><strong>{c.pv}</strong><small>meq O₂/kg</small></div><div><span>TOTOX</span><strong>{c.totox??'—'}</strong><small>{c.totox?t('Calculated from example values','Calcolato dai valori di esempio'):t('Cannot be calculated','Non calcolabile')}</small></div></div>
<p class="v3-small">{t('All displayed values are illustrative. No overall risk score or shelf-life prediction is generated.','Tutti i valori mostrati sono illustrativi. Non viene generato un punteggio di rischio complessivo o una previsione di conservabilità.')}</p>
{[
[t('Batch identity','Identità del lotto'),t('Bovine tallow · triglyceride form · '+c.batch,'Sego bovino · forma trigliceridica · '+c.batch),t('A real record would identify the sampled batch, quantity, producer, sampling date and sampling responsibility. A name alone does not establish identity.','Un documento reale identificherebbe lotto campionato, quantità, produttore, data e responsabilità del campionamento. Un nome da solo non dimostra l’identità.')],
[t('Documented provenance','Provenienza documentata'),c.id==='missing'?t('Chain-of-custody evidence missing','Documenti della catena di custodia mancanti'):t('Document references would be linked here','Qui sarebbero collegati i riferimenti documentali'),t('Verify the link from source material through processing to the sampled batch. Species or a geographic description cannot substitute for a connected documentary trail. No actual records are attached to this specimen.','Verificare il collegamento dalla materia iniziale attraverso il processo al lotto campionato. Specie o descrizione geografica non sostituiscono una catena documentale. A questo esempio non sono allegati documenti reali.')],
[t('Chemical form','Forma chimica'),t('Declared as triglyceride tallow in the example','Dichiarato come sego trigliceridico nell’esempio'),t('State the actual material and processing history. Evidence on a chemically different derivative cannot be applied simply because its name contains “tallow”.','Dichiarare la materia effettiva e la storia di processo. L’evidenza su un derivato chimicamente diverso non è trasferibile solo perché il nome contiene “sego”.')],
[t('Profile and acidity','Profilo e acidità'),c.acid?t('Acid value: '+c.acid+' mg KOH/g · illustrative','Numero di acidità: '+c.acid+' mg KOH/g · illustrativo'):t('Acid value unavailable','Numero di acidità non disponibile'),t('Record acid value with the ISO 660 report and a full fatty acid profile with its method. The profile is not supplied in this specimen. The acid value is a material parameter, not a validated skin-safety threshold.','Riportare il numero di acidità con il referto ISO 660 e il profilo completo degli acidi grassi con il metodo. Il profilo non è fornito in questo esempio. Il numero di acidità è un parametro della materia, non una soglia validata di sicurezza cutanea.')],
[t('Oxidative state','Stato ossidativo'),c.anv?t('PV '+c.pv+'; p-anisidine '+c.anv+'; TOTOX '+c.totox+' · illustrative','PV '+c.pv+'; p-anisidina '+c.anv+'; TOTOX '+c.totox+' · illustrativi'):t('PV present; p-anisidine missing; TOTOX unavailable','PV presente; p-anisidina mancante; TOTOX non disponibile'),t('TOTOX = 2 × peroxide value + p-anisidine value. Preserve the component measurements and methods. Reference methods include ISO 3960 for peroxides and ISO 6885 for p-anisidine. A composite index cannot predict a clinical result.','TOTOX = 2 × numero di perossidi + numero di p-anisidina. Conservare misure componenti e metodi. Fra i metodi di riferimento, ISO 3960 per i perossidi e ISO 6885 per la p-anisidina. Un indice composito non può prevedere un esito clinico.')],
[t('Physical behaviour','Comportamento fisico'),t('Not populated in this specimen','Non compilato in questo esempio'),t('A real dossier would record the agreed physical tests, such as solid fat content at relevant temperatures and melting behaviour. These describe the material; formula performance requires its own evaluation.','Un dossier reale riporterebbe i test fisici concordati, come contenuto di grasso solido alle temperature rilevanti e comportamento alla fusione. Descrivono la materia; le prestazioni in formula richiedono una valutazione propria.')],
[t('Process and storage','Processo e conservazione'),t('Processing records required','Registrazioni di processo necessarie'),t('Record time, temperature, antioxidants and storage conditions from actual records. No storage duration or shelf-life claim can be derived from these invented values.','Riportare tempi, temperature, antiossidanti e condizioni di conservazione da registri effettivi. Da questi valori inventati non si può ricavare una durata di conservazione.')],
[t('Compliance documents','Documenti di conformità'),t('Not verified in this specimen','Non verificati in questo esempio'),t('List the documents required for the material and intended pathway, their issuers, dates and scope. A Passport organises those documents; it does not replace them or approve a finished cosmetic.','Elencare documenti richiesti per materia e percorso previsto, emittenti, date e perimetro. Il Passaporto li organizza; non li sostituisce e non approva un cosmetico finito.')],
[t('What has not been tested','Cosa non è stato testato'),t('Skin outcomes · comedogenicity · release on skin · alpha-gal','Esiti cutanei · comedogenicità · rilascio sulla pelle · alpha-gal'),t('No results for these endpoints are supplied here. Missing data stays missing. It is not converted into an assumption of safety or efficacy. The analytical panel itself is also incomplete in this specimen.','Qui non sono forniti risultati su questi esiti. Un dato mancante resta mancante. Non diventa un’assunzione di sicurezza o efficacia. Anche il pannello analitico di questo esempio è incompleto.')]
].map(([title,value,note],i)=><details class="passport-field" open={i===8}><summary><span class="passport-index">{String(i+1).padStart(2,'0')}</span><span><strong>{title}</strong><span class="passport-value">{value}</span></span><span aria-hidden="true">＋</span></summary><p>{note}</p></details>)}
<div class="passport-bottom"><span>{t('Document status: specimen','Stato documento: esempio')}</span><span>{t('Issuer: none · No sign-off','Emittente: nessuno · Nessuna approvazione')}</span></div>
</article>)}</div><aside class="passport-guide"><p class="v3-eyebrow">{t('How to read it','Come leggerlo')}</p><h2>{t('Three layers of information.','Tre livelli di informazione.')}</h2><h3>{t('01 / The result','01 / Il risultato')}</h3><p>{t('What was measured, on which sample, with what method and uncertainty. Here, the numbers are invented.','Cosa è stato misurato, su quale campione, con quale metodo e incertezza. Qui i numeri sono inventati.')}</p><h3>{t('02 / The interpretation','02 / L’interpretazione')}</h3><p>{t('What the result suggests for the agreed specification. Interpretation should remain separate from the laboratory result.','Cosa suggerisce il risultato rispetto alla specifica concordata. L’interpretazione resta separata dal referto.')}</p><h3>{t('03 / The next decision','03 / La prossima decisione')}</h3><p>{t('Continue the review, investigate an issue or obtain missing evidence. A complete-looking document is not automatic approval.','Proseguire la verifica, indagare un problema o acquisire evidenze mancanti. Un documento apparentemente completo non è un’approvazione automatica.')}</p><div class="v3-note"><p><strong>{t('Reference, not skin-safety limit.','Riferimento, non limite di sicurezza cutanea.')}</strong> {t('The Codex appendix lists an acid value of 2.5 mg KOH/g for edible tallow. It is supplementary food-quality information, not a cosmetic safety threshold or proof of full conformity.','L’appendice Codex riporta 2,5 mg KOH/g per il numero di acidità del sego alimentare. È informazione supplementare di qualità alimentare, non una soglia di sicurezza cosmetica o una prova di conformità completa.')}</p><a href={fao} target="_blank" rel="noopener noreferrer">CXS 211-1999 ↗</a></div><a href={b+'/'+t('offer','proposta')}>{t('Discuss a real pilot','Discuti un pilota reale')} →</a></aside></div>
<section class="v3-contact"><h2>{t('What would make this useful to your team?','Cosa lo renderebbe utile al tuo team?')}</h2><p>{t('The format is a proposal. A pilot should test which fields inform a real decision, which records are missing and what belongs in your supplier workflow.','Il formato è una proposta. Un pilota dovrebbe verificare quali campi orientano una decisione reale, quali documenti mancano e cosa serve nel processo di valutazione dei fornitori.')}</p><a class="v3-button primary" href={b+'/'+t('offer','proposta')+'#pilot'}>{t('Discuss the pilot scope','Discuti il perimetro del pilota')} →</a><p><a href={b+'/amsa'}>{t('Read the proposed measurement approach','Leggi l’approccio di misura proposto')} →</a></p></section>
<script>
const controls=document.querySelector('.passport-controls');
const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-case]'));
const panels=Array.from(document.querySelectorAll<HTMLElement>('.passport-page'));
const announcement=document.querySelector('.passport-announcement');
if(controls instanceof HTMLElement&&buttons.length&&panels.length){
 controls.hidden=false;
 const select=(id:string,announce:boolean)=>{
  buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.case===id)));
  panels.forEach(panel=>panel.hidden=panel.id!=='case-'+id);
  if(announce&&announcement) announcement.textContent=panels.find(p=>!p.hidden)?.querySelector('.passport-decision h3')?.textContent??'';
 };
 buttons.forEach(button=>button.addEventListener('click',()=>select(button.dataset.case!,true)));
 select('baseline',false);
}
</script>
<style>
.passport-disclaimer{background:#eeece3;border:1px solid #d0c8ac;padding:1.1rem 1.4rem;font-size:.92rem;max-width:65rem;margin-bottom:2rem}.passport-controls{margin:2rem 0}.passport-controls[hidden]{display:none}.passport-controls .v3-eyebrow{margin-bottom:.8rem}.passport-buttons{display:flex;gap:.6rem;flex-wrap:wrap}.passport-buttons button{padding:.85rem 1.1rem;background:transparent;border:1px solid #8b9f95;color:var(--ink);font-size:.92rem;min-height:48px}.passport-buttons button[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}.passport-announcement{position:absolute;clip-path:inset(50%);height:1px;width:1px;overflow:hidden}.passport-layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,1fr);gap:3rem;align-items:start}.passport-page{background:#fff;border:1px solid #bacbc1;border-top:5px solid #176c53;padding:2rem;margin-bottom:2rem;box-shadow:8px 8px 0 #e1eee6}.passport-page[hidden]{display:none}.passport-top{display:flex;justify-content:space-between;gap:1.5rem;border-bottom:1px solid var(--rule);padding-bottom:1rem}.passport-top h2{font-size:2rem;margin:0}.passport-top p{margin:.5rem 0}.passport-stamp{font-family:var(--ode-font-mono);font-size:.65rem;white-space:pre-line;text-align:right;color:var(--muted)}.passport-decision{padding:1.3rem;margin:1.5rem 0;background:#eaf2ed;border-left:3px solid #176c53}.passport-decision.review{background:#f4eee3;border-color:#976626}.passport-decision.missing{background:#edf0f4;border-color:#5a6e83}.passport-decision h3{font-size:1.25rem;margin:.5rem 0}.passport-decision p{font-size:.92rem;margin:.6rem 0 0}.passport-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:1rem 0}.passport-metrics>div{display:flex;flex-direction:column;gap:.4rem}.passport-metrics span{font-size:.85rem}.passport-metrics strong{font-family:var(--ode-font-mono);font-weight:400;font-size:2rem;line-height:1.1}.passport-metrics small{font-size:.75rem;color:var(--muted)}.passport-field{border-top:1px solid var(--rule);padding:1rem 0}.passport-field summary{display:flex;gap:1rem;align-items:baseline;list-style:none;cursor:pointer}.passport-field summary>span:nth-child(2){flex:1}.passport-field summary strong{font-size:1rem;font-weight:500}.passport-index{font-family:var(--ode-font-mono);font-size:.8rem;color:var(--muted)}.passport-value{display:block;font-size:.85rem;color:var(--muted);margin-top:.3rem}.passport-field p{margin:1rem 0 .4rem 2.2rem;font-size:.92rem}.passport-field[open] summary>span:last-child{transform:rotate(45deg)}.passport-bottom{display:flex;flex-wrap:wrap;gap:1rem;font-family:var(--ode-font-mono);font-size:.7rem;border-top:1px solid var(--rule);padding-top:1rem;color:var(--muted)}.passport-guide{padding-top:1rem}.passport-guide h2{font-size:2rem}.passport-guide h3{font-size:1.1rem;margin-top:2rem}.passport-guide p{font-size:.95rem}.passport-guide .v3-note{padding:1rem}
@media(max-width:900px){.passport-layout{grid-template-columns:1fr;gap:1rem}.passport-guide{max-width:45rem}.passport-page{margin-right:8px}}
@media(max-width:500px){.passport-page{padding:1.2rem}.passport-top{flex-direction:column;gap:.3rem}.passport-stamp{text-align:left;white-space:normal}.passport-metrics{gap:.7rem}.passport-metrics strong{font-size:1.7rem}.passport-metrics span{font-size:.8rem}.passport-field p{margin-left:0}.passport-buttons{display:grid}.passport-buttons button{text-align:left}}
</style>
