---
import Layout from '../../layouts/OdeV3Layout.astro';
const {lang='en'}=Astro.props; const it=lang==='it'; const b='/OdE/test2'+(it?'/it':'');
const t=(en:string,italian:string)=>it?italian:en;
const url=(en:string,italian:string)=>b+'/'+t(en,italian);
const doors=[
[t('For formulators & buyers','Per formulatori e acquirenti'),t('Evaluate the proposed pilot.','Valutare il pilota proposto.'),t('See the intended deliverable, the work to agree together, and what the document can support.','Il documento previsto, il lavoro da concordare e le decisioni che può supportare.'),url('offer','proposta'),t('Explore the offer','Esplora la proposta')],
[t('For research partners','Per i partner di ricerca'),t('Help answer the next question.','Affrontare la prossima domanda.'),t('Start with lipid characterisation and the composition of what microbial lipases release.','Dalla caratterizzazione lipidica alla composizione di ciò che le lipasi microbiche liberano.'),url('research','collaborare'),t('Read the collaboration brief','Leggi la proposta di collaborazione')],
[t('For investors','Per gli investitori'),t('Fund evidence of demand.','Finanziare la verifica della domanda.'),t('Understand the proposed sequence, the costs to test it and the conditions for continuing.','La sequenza proposta, i costi per verificarla e le condizioni per proseguire.'),url('investors','investitori'),t('Read the investment case','Leggi il caso di investimento')]
];
---
<Layout title="Officina degli Estratti · Batch qualification" lang={lang} editorial>
<section class="v3-hero"><div><p class="v3-eyebrow">{t('Animal-derived lipids / Batch qualification','Lipidi di origine animale / Qualificazione di lotto')}</p><h1>{t('Know the material. Make a better decision.','Conoscere la materia. Decidere meglio.')}</h1><p class="v3-lede">{t('OdE is developing a qualification service for tallow used in cosmetic formulation. One batch document would bring together provenance, analytical results and the limits of what is known.','OdE sta sviluppando un servizio di qualificazione del sego destinato alla formulazione cosmetica. Un documento di lotto riunirebbe provenienza, risultati analitici e limiti delle conoscenze disponibili.')}</p><div class="v3-actions"><a class="v3-button primary" href={url('passport','passaporto')}>{t('Explore a Passport','Esplora un Passaporto')} <span aria-hidden="true">↗</span></a><a class="v3-text-link" href={url('offer','proposta')}>{t('What the pilot would deliver','Cosa prevede il pilota')} →</a></div><p class="v3-small">{t('Development stage. The Passport below is an illustrative specimen, not a certificate for a tested batch.','Progetto in sviluppo. Il Passaporto qui accanto è un esempio illustrativo, non il certificato di un lotto analizzato.')}</p></div>
<a class="v3-specimen" href={url('passport','passaporto')} style="text-decoration:none" aria-label={t('Explore the illustrative Digital Lipid Passport','Esplora il Passaporto Lipidico Digitale illustrativo')}><div class="v3-document-head"><strong>Digital<br/>Lipid Passport</strong><span>OdE / SPECIMEN<br/>DEMO–001</span></div><p class="v3-doc-label">{t('A proposed batch record','Un documento di lotto proposto')}</p><div class="v3-doc-row"><span>{t('Material identity','Identità della materia')}</span><span>{t('Bovine tallow','Sego bovino')}</span></div><div class="v3-doc-row"><span>{t('Provenance','Provenienza')}</span><span>{t('Documents to verify','Documenti da verificare')}</span></div><div class="v3-doc-row"><span>{t('Acid value · ISO 660','Numero di acidità · ISO 660')}</span><span>0.8 mg KOH/g *</span></div><div class="v3-doc-row"><span>{t('Oxidative state','Stato ossidativo')}</span><span>{t('Panel, methods, limits','Pannello, metodi, limiti')}</span></div><div class="v3-doc-note"><strong>{t('What has not been tested','Cosa non è stato testato')}</strong><br/>{t('Skin outcomes. Comedogenicity. Release on skin.','Esiti cutanei. Comedogenicità. Rilascio sulla pelle.')}</div><p class="v3-small">{t('* Invented value for this demonstration. No laboratory result is represented here.','* Valore inventato per questa dimostrazione. Non rappresenta un risultato di laboratorio.')}</p><span class="v3-document-link">{t('Open the annotated specimen','Apri l’esempio commentato')} ↗</span></a></section>
<div class="v3-strip"><div><span class="v3-status">{t('Documented research','Ricerca documentata')}</span><p class="v3-small">{t('Literature review, evidence audit and a proposed measurement framework.','Revisione della letteratura, audit delle evidenze e un quadro analitico proposto.')}</p></div><div><span class="v3-status pending">{t('In development','In sviluppo')}</span><p class="v3-small">{t('The qualification workflow, Passport and AMSA measurement platform.','Il processo di qualificazione, il Passaporto e la piattaforma di misura AMSA.')}</p></div><div><span class="v3-status pending">{t('To validate','Da validare')}</span><p class="v3-small">{t('Buyer demand, performance on real batches and the analytical model.','Domanda dei clienti, prestazioni sui lotti reali e modello analitico.')}</p></div></div>
<section class="v3-section"><div class="v3-section-top"><h2>{t('A batch is more than an ingredient name.','Un lotto è più del nome di un ingrediente.')}</h2><p>{t('Species, feed, storage and processing can change a lipid material. The pilot would test whether bringing its records and measurements together makes supplier evaluation more useful for a formulator.','Specie, alimentazione, conservazione e processo possono modificare una materia lipidica. Il pilota verificherebbe se riunire documenti e misure rende più utile la valutazione del fornitore per un formulatore.')}</p></div><div class="v3-grid">{[
[t('Trace the origin','Ricostruire l’origine'),t('Connect a batch to its documents. State where traceability ends and which links still need verification.','Collegare il lotto ai suoi documenti. Dichiarare dove si ferma la tracciabilità e quali passaggi richiedono verifica.')],
[t('Describe the material','Descrivere la materia'),t('Record composition, acidity and oxidative condition alongside methods and the date of analysis.','Riportare composizione, acidità e stato ossidativo insieme ai metodi e alla data di analisi.')],
[t('Make the limits usable','Rendere utilizzabili i limiti'),t('Separate a result from an interpretation. Make missing information visible before a formulation decision.','Separare il risultato dall’interpretazione. Rendere visibili le informazioni mancanti prima di una decisione formulativa.')]
].map(([h,p],i)=><article class="v3-card"><span class="v3-num">0{i+1}</span><h3>{h}</h3><p>{p}</p></article>)}</div></section>
<section class="v3-band"><div><p class="v3-eyebrow">{t('The boundary that matters','Il confine che conta')}</p><h2>{t('Material quality and skin performance are different questions.','Qualità della materia ed effetti sulla pelle sono domande diverse.')}</h2></div><div><p>{t('A characterised batch does not establish a clinical benefit. Our literature review found no qualifying controlled human study of unmodified topical beef tallow with instrumental skin outcomes in the sources searched. That defines a research question, not a product claim.','Un lotto caratterizzato non dimostra un beneficio clinico. La nostra revisione non ha individuato, nelle fonti consultate, studi controllati qualificanti sul sego bovino non modificato applicato sulla pelle umana con esiti strumentali. È una domanda di ricerca, non una promessa di prodotto.')}</p><div class="v3-actions"><a class="v3-button" href={url('evidence','ricerca')}>{t('Examine the evidence','Esamina le evidenze')} →</a></div></div></section>
<section class="v3-section"><div class="v3-section-top"><h2>{t('Three ways to take the next step.','Tre modi per fare il prossimo passo.')}</h2><p>{t('The project needs practical questions from formulators, specialised research capability and disciplined capital. Start with the part relevant to you.','Il progetto richiede domande concrete dai formulatori, competenze scientifiche specialistiche e capitale impiegato con disciplina. Parti dal tema che ti riguarda.')}</p></div><div class="v3-grid">{doors.map(([who,h,p,href,label])=><article class="v3-card"><p class="v3-eyebrow">{who}</p><h3>{h}</h3><p>{p}</p><a href={href}>{label} →</a></article>)}</div></section>
<section class="v3-contact"><p class="v3-eyebrow">{t('Led by Matteo Martignoni','Un progetto di Matteo Martignoni')}</p><h2>{t('A commercial question, approached through measurement.','Una domanda commerciale, affrontata attraverso le misure.')}</h2><p>{t('Experience in beauty, brand development and product leadership informs the project. Specialist laboratory work and the animal by-product pathway require dedicated expertise.','L’esperienza nella cosmetica, nello sviluppo dei marchi e nella direzione prodotto orienta il progetto. Il lavoro di laboratorio e il percorso dei sottoprodotti animali richiedono competenze dedicate.')}</p><a href={url('project','progetto')}>{t('People, stage and next milestones','Persone, stato e prossime tappe')} →</a></section>
</Layout>
