---
import Layout from '../../layouts/OdeV3Layout.astro';
const {lang='en'}=Astro.props;const it=lang==='it';const t=(a:string,b:string)=>it?b:a;const b='/OdE/test2'+(it?'/it':'');
---
<Layout title={t('Research collaboration · OdE','Collaborare alla ricerca · OdE')} lang={lang} editorial>
<header class="v3-page-head"><p class="v3-eyebrow">{t('For research partners','Per i partner di ricerca')}</p><h1>{t('What is released matters as much as how much.','Cosa si libera conta quanto la quantità.')}</h1><p class="v3-lede">{t('The focused research question is how microbial lipases act on the material, and which fatty acids they release. A change in acid value describes quantity; it does not by itself describe the composition or biological effect of that release.','La domanda di ricerca mirata riguarda l’azione delle lipasi microbiche sulla materia e gli acidi grassi che liberano. La variazione del numero di acidità descrive una quantità; da sola non descrive la composizione o l’effetto biologico del rilascio.')}</p><div class="v3-actions"><a class="v3-button primary" href="#collaborate">{t('Discuss the research brief','Discuti il brief di ricerca')} ↗</a><a href={b+'/'+t('open-evidence','evidenza')}>{t('Full programme and decision criteria','Programma completo e criteri decisionali')} →</a></div></header>
<section class="v3-section"><div class="v3-section-top"><h2>{t('Characterise first. Investigate release next.','Prima caratterizzare. Poi studiare il rilascio.')}</h2><p>{t('The work needs a known starting material. A first collaboration could be limited to the analytical baseline, with the hydrolysis study commissioned only after its design and resources are agreed.','Il lavoro richiede una materia iniziale nota. Una prima collaborazione può limitarsi alla base analitica, commissionando lo studio di idrolisi solo dopo averne concordato disegno e risorse.')}</p></div><div class="v3-grid two"><article class="v3-card"><span class="v3-num">01 / {t('Analytical baseline','Base analitica')}</span><h3>{t('What is the starting material?','Qual è la materia di partenza?')}</h3><p>{t('Define composition, acid value and physical state on the sample to be studied. Establish sample handling and the reference methods before interpreting a change.','Definire composizione, numero di acidità e stato fisico del campione. Stabilire la gestione del campione e i metodi di riferimento prima di interpretare una variazione.')}</p><p class="v3-small">{t('Expertise: lipid chemistry and analytical characterisation.','Competenze: chimica lipidica e caratterizzazione analitica.')}</p></article><article class="v3-card"><span class="v3-num">02 / {t('Proposed study','Studio proposto')}</span><h3>{t('What changes during hydrolysis?','Cosa cambia durante l’idrolisi?')}</h3><p>{t('Measure the rate and composition of release under an agreed in vitro protocol. Test whether the released fraction differs from the initial lipid profile.','Misurare velocità e composizione del rilascio con un protocollo in vitro concordato. Verificare se la frazione liberata differisce dal profilo lipidico iniziale.')}</p><p class="v3-small">{t('Expertise: enzymology, microbiology and lipid analysis.','Competenze: enzimologia, microbiologia e analisi lipidica.')}</p></article></div></section>
<section class="v3-section"><div class="v3-section-top"><h2>{t('A brief to shape together.','Un brief da definire insieme.')}</h2><p>{t('OdE brings a documented literature review, a proposed sequence of questions and commercial context. Sample access, funding and laboratory arrangements must be confirmed for the specific collaboration.','OdE porta una revisione documentale, una sequenza proposta di domande e il contesto commerciale. Accesso ai campioni, finanziamento e accordi di laboratorio vanno confermati per la singola collaborazione.')}</p></div><div class="v3-table-wrap"><table class="v3-table"><tbody>{[
[t('Proposed output','Risultato previsto'),t('An analytical dataset, methods, uncertainty and an interpretation that includes unfavourable or inconclusive results.','Un dataset analitico, metodi, incertezza e un’interpretazione che includa risultati sfavorevoli o inconcludenti.')],
[t('Planning estimate','Stima di pianificazione'),t('€8,000–18,000 and 2–4 months for the in vitro hydrolysis study in the existing programme. These are internal estimates, not quotations or committed funding.','8.000–18.000 € e 2–4 mesi per lo studio di idrolisi in vitro nel programma esistente. Sono stime interne, non preventivi o finanziamenti impegnati.')],
[t('Design before execution','Disegno prima dell’esecuzione'),t('Agree the matrix, enzymes, controls, sampling points, replication and analysis plan. Review the proposed stopping criteria for scientific suitability.','Concordare matrice, enzimi, controlli, tempi di campionamento, repliche e piano di analisi. Valutare l’adeguatezza scientifica dei criteri di arresto proposti.')],
[t('Publication and ownership','Pubblicazione e proprietà'),t('Agree authorship, publication rights, confidentiality and ownership before the work. Academic and commissioned research need different arrangements.','Concordare attribuzione, diritti di pubblicazione, riservatezza e proprietà prima del lavoro. Ricerca accademica e su commissione richiedono accordi diversi.')]
].map(([h,p])=><tr><th scope="row">{h}</th><td>{p}</td></tr>)}</tbody></table></div></section>
<aside class="v3-note"><p>{t('A result about hydrolysis in vitro would not establish a clinical outcome on skin. It could refine the hypothesis, change the next experiment or show that the proposed approach needs to be reconsidered.','Un risultato sull’idrolisi in vitro non dimostrerebbe un esito clinico sulla pelle. Potrebbe precisare l’ipotesi, cambiare l’esperimento successivo o indicare la necessità di rivedere l’approccio.')}</p></aside>
<section class="v3-contact" id="collaborate"><p class="v3-eyebrow">{t('A useful first exchange','Un primo confronto utile')}</p><h2>{t('Does this overlap with your work?','Questo tema incontra il tuo lavoro?')}</h2><p>{t('Tell us your relevant methods, which part of the question interests you and what collaboration format might fit. A methodological objection is welcome too.','Indicaci i metodi pertinenti, quale parte della domanda ti interessa e quale forma di collaborazione sarebbe adatta. È benvenuta anche un’obiezione metodologica.')}</p><a class="v3-button primary" href="mailto:mm@matteomartignoni.com?subject=OdE%20research%20collaboration">{t('Contact Matteo','Contatta Matteo')} ↗</a><p><a href={b+'/'+t('open-evidence','evidenza')}>{t('Read the full research programme and its source notes','Leggi il programma completo e le note sulle fonti')} →</a></p></section>
</Layout>
