---
import Layout from '../../layouts/OdeV3Layout.astro';
const {lang='en'}=Astro.props;const it=lang==='it';const t=(a:string,b:string)=>it?b:a;const b='/OdE/test2'+(it?'/it':'');const notes=b+'/'+t('investment-notes','note-investimento');
---
<Layout title={t('The investment case · OdE','Il caso di investimento · OdE')} lang={lang} editorial>
<header class="v3-page-head"><p class="v3-eyebrow">{t('For investors / Development stage','Per gli investitori / Progetto in sviluppo')}</p><h1>{t('Test the demand before scaling the programme.','Verificare la domanda prima di ampliare il programma.')}</h1><p class="v3-lede">{t('The investment hypothesis is a qualification and documentation service for a narrow group of cosmetic formulators. Its value would depend on useful proprietary data, credible delivery and willingness to pay. Those conditions still need to be demonstrated.','L’ipotesi di investimento è un servizio di qualificazione e documentazione per un gruppo ristretto di formulatori cosmetici. Il valore dipenderebbe da dati proprietari utili, capacità di realizzazione e disponibilità a pagare. Queste condizioni devono ancora essere dimostrate.')}</p><div class="v3-actions"><a class="v3-button primary" href="#conversation">{t('Discuss the milestones','Discuti le prossime tappe')} ↗</a><a href={notes}>{t('Read the full investment dossier','Leggi il dossier completo')} →</a></div></header>
<div class="v3-strip"><div><span class="v3-status">{t('Commercial hypothesis','Ipotesi commerciale')}</span><p class="v3-small">{t('A documented, characterised batch has value to a formulator evaluating an ingredient.','Un lotto documentato e caratterizzato ha valore per un formulatore che valuta un ingrediente.')}</p></div><div><span class="v3-status pending">{t('Next evidence','Prossima evidenza')}</span><p class="v3-small">{t('Qualified conversations, a scoped pilot and a credible path to paid work.','Confronti qualificati, un pilota definito e un percorso credibile verso incarichi remunerati.')}</p></div><div><span class="v3-status pending">{t('Not established','Non dimostrato')}</span><p class="v3-small">{t('Market size, unit economics, validated platform performance or a durable competitive advantage.','Dimensione del mercato, economia unitaria, prestazioni validate della piattaforma o vantaggio competitivo duraturo.')}</p></div></div>
<section class="v3-section"><div class="v3-section-top"><h2>{t('Three decisions. Separate budgets.','Tre decisioni. Budget distinti.')}</h2><p>{t('The inexpensive market test and the analytical programme answer different questions. A positive conversation does not validate the science; a positive laboratory result does not establish a market.','La verifica commerciale iniziale e il programma analitico rispondono a domande diverse. Un confronto positivo non valida la scienza; un risultato di laboratorio positivo non dimostra un mercato.')}</p></div><div class="v3-grid">{[
[t('Explore demand','Esplorare la domanda'),'€1,000–3,000',t('90-day planning horizon','Orizzonte di pianificazione: 90 giorni'),t('Prepare a credible exploratory dossier and hold 8–10 qualified conversations. Seek sample interest or a second technical discussion. This is an interest test, not proof of revenue.','Preparare un dossier esplorativo credibile e svolgere 8–10 confronti qualificati. Cercare interesse per campioni o un secondo confronto tecnico. È una verifica di interesse, non una prova di ricavi.')],
[t('Qualify real material','Qualificare materia reale'),'€18,000–41,000',t('4–6 months, estimated','4–6 mesi, stimati'),t('The minimum programme combines analytical work, documentation and safety-related investigations. Confirm quotations, scope and delivery responsibilities before commitment.','Il programma minimo combina analisi, documentazione e indagini relative alla sicurezza. Confermare preventivi, perimetro e responsabilità prima di impegnare risorse.')],
[t('Build differentiated data','Produrre dati distintivi'),'€55,000–90,000',t('8–12 months, estimated','8–12 mesi, stimati'),t('The intermediate programme adds hydrolysis, barrier and sensory work. This total includes the minimum programme; it is not an additional sum.','Il programma intermedio aggiunge studi su idrolisi, barriera e sensorialità. Il totale include il programma minimo; non è una somma aggiuntiva.')]
].map(([h,n,d,p],i)=><article class="v3-card"><span class="v3-num">0{i+1}</span><h3>{h}</h3><strong class="v3-number">{n}</strong><span class="v3-small">{d}</span><p>{p}</p></article>)}</div><p class="v3-small">{t('Internal planning estimates from the existing research dossier, not supplier quotations, customer prices or an announced funding round. Stage 1 is a separate exploratory budget, not a claim that the full programme can be delivered for €3,000.','Stime interne del dossier di ricerca, non preventivi, prezzi al cliente o un round annunciato. La prima fase è un budget esplorativo separato, non l’affermazione che l’intero programma sia realizzabile con 3.000 €.')}</p><a href={notes+'#sec-3'}>{t('Inspect scenario assumptions and the full programme','Esamina le ipotesi degli scenari e il programma completo')} →</a></section>
<section class="v3-band"><h2>{t('What could make the business defensible?','Cosa potrebbe rendere difendibile l’attività?')}</h2><div><p>{t('Repeated access to characterised batches, a useful dataset and a document that becomes part of the customer’s workflow. The proposed advantage must be earned through execution. A literature review, an algorithm or a first-mover claim is not enough on its own.','Accesso ripetuto a lotti caratterizzati, un dataset utile e un documento che entri nel lavoro del cliente. Il vantaggio proposto va costruito attraverso l’esecuzione. Una revisione della letteratura, un algoritmo o un primato temporale da soli non bastano.')}</p><div class="v3-actions"><a class="v3-button" href={b+'/'+t('passport','passaporto')}>{t('Examine the proposed product','Esamina il prodotto proposto')} →</a></div></div></section>
<section class="v3-section"><div class="v3-section-top"><h2>{t('The questions before an investment decision.','Le domande prima di investire.')}</h2><p>{t('The full dossier contains the risk analysis. These are the immediate commercial and execution tests.','Il dossier completo contiene l’analisi dei rischi. Queste sono le verifiche commerciali e operative immediate.')}</p></div>{[
[t('Will a customer pay for the package?','Un cliente pagherà il pacchetto?'),t('Interest in a sample is an early signal. Paid scope, repeat demand and the cost of serving that demand remain to be tested.','L’interesse per un campione è un primo segnale. Perimetro remunerato, domanda ripetuta e costo per servirla restano da verificare.')],
[t('Can delivery be assembled credibly?','È possibile organizzare una realizzazione credibile?'),t('Material access, laboratory capacity and the by-product pathway require confirmed arrangements. They cannot be inferred from the website’s technical detail.','Accesso alla materia, capacità di laboratorio e percorso dei sottoprodotti richiedono accordi confermati. Non si possono dedurre dal dettaglio tecnico del sito.')],
[t('What happens if a hypothesis fails?','Cosa accade se un’ipotesi non regge?'),t('A negative skin-related result may change the material proposition. Lack of buyer demand may change the business itself. Analytical or data services are possible alternatives, each requiring its own validation.','Un risultato cutaneo negativo può modificare la proposta sulla materia. L’assenza di domanda può modificare l’attività stessa. Servizi analitici o sui dati sono alternative possibili, ciascuna da validare.')],
[t('What role does AI actually play?','Qual è il ruolo effettivo dell’IA?'),t('AMSA’s models must show value against reference methods and a chemometric baseline. Model complexity and potential funding eligibility are not substitutes for performance.','I modelli AMSA devono dimostrare valore rispetto ai metodi di riferimento e a una base chemiometrica. Complessità del modello e possibile accesso ad agevolazioni non sostituiscono le prestazioni.')]
].map(([h,p])=><details class="v3-details"><summary>{h}</summary><p>{p}</p></details>)}</section>
<section class="v3-contact" id="conversation"><p class="v3-eyebrow">{t('The current invitation','L’invito attuale')}</p><h2>{t('Discuss a milestone-based plan.','Discutere un piano per tappe verificabili.')}</h2><p>{t('This page does not announce a funding round, valuation or investment terms. The next conversation is about the proposed scope, evidence required and resources needed to reach the next decision.','Questa pagina non annuncia un round, una valutazione o condizioni di investimento. Il prossimo confronto riguarda perimetro, evidenze e risorse necessarie per arrivare alla decisione successiva.')}</p><a class="v3-button primary" href="mailto:mm@matteomartignoni.com?subject=OdE%20investment%20milestones">{t('Contact Matteo','Contatta Matteo')} ↗</a><p><a href={b+'/'+t('project','progetto')}>{t('People and project maturity','Persone e maturità del progetto')} →</a></p></section>
</Layout>
